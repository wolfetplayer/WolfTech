itemDef {
	name ctr_look
	text "@CONTROLS_LOOK"
	textfont		UI_FONT_BIG
	type ITEM_TYPE_BUTTON
	textscale .23
	group grpControlbutton
	style WINDOW_STYLE_FILLED
	rect 2 4 107 20
	textalign ITEM_ALIGN_CENTER
	textalignx 53
	textaligny 14
	border 1
	bordercolor .5 .5 .5 .5
	forecolor 1 1 1 1
	backcolor .3 0.5 0.2 .25
	visible 1
	action { play "sound/misc/kcaction.wav" ;
	hide grpControls ; show look ;
	setitemcolor ctr_look backcolor .3 0.5 0.2 .25 ; setitemcolor ctr_move backcolor .1 .1 .1 .25 ; setitemcolor ctr_shoot backcolor .1 .1 .1 .25 ; setitemcolor ctr_miscellaneous backcolor .1 .1 .1 .25 }
	}
	

	itemDef {
		name look
		group grpControls
		type ITEM_TYPE_MULTI
		text "@CONTROLS_PLAYERVIEW"
