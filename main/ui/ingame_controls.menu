#include "ui/menudef.h"

{
\\ INGAME CONTROLS TAB (non-bind settings; key binds moved to ingame_editkeyboard) \\

menuDef {
    	name "ingame_controls"
    	visible 0
    	fullscreen 0
		rect 220 110 443 366
    	focusColor 1 .75 0 1
    	style 1
    	border 1

itemDef {
		name icr_invertmouse
		type ITEM_TYPE_MULTI
		text "@CONTROLS_INVERTMOUSE"
		textfont		UI_FONT_BIG
		cvar "ui_mousePitch"
		cvarFloatList		{ "@GENERAL_NO" 0 "@GENERAL_YES" 1 }
		rect 0 0 443 16
		textalign ITEM_ALIGN_RIGHT
		textalignx 224
		textaligny 12
		textscale .22
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
		forecolor 1 1 1 1
		visible 1
		action { uiScript update ui_mousePitch }
		mouseEnter { setitemcolor icr_invertmouse backcolor .3 0.5 0.2 .25 ; show tip_icr_invertmouse ; show tipbox }
		mouseExit { setitemcolor icr_invertmouse backcolor 1 1 1 .07 ; hide tip_icr_invertmouse ; hide tipbox }
		}

	itemDef {
		name icr_smoothmouse
		type ITEM_TYPE_MULTI
		text "@CONTROLS_SMOOTHMOUSE"
		textfont		UI_FONT_BIG
		cvar "m_filter"
		cvarFloatList		{ "@GENERAL_NO" 0 "@GENERAL_YES" 1 }
		rect 0 19 443 16
		textalign ITEM_ALIGN_RIGHT
		textalignx 224
		textaligny 12
		textscale .22
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
		forecolor 1 1 1 1
		visible 1
		mouseEnter { setitemcolor icr_smoothmouse backcolor .3 0.5 0.2 .25 ; show tip_icr_smoothmouse ; show tipbox }
		mouseExit { setitemcolor icr_smoothmouse backcolor 1 1 1 .07 ; hide tip_icr_smoothmouse ; hide tipbox }
		}

	itemDef {
		name icr_mousesens
		type ITEM_TYPE_SLIDER
		text "@CONTROLS_MOUSESENSITIVITY"
		textfont		UI_FONT_BIG
		cvarfloat "sensitivity" 5 1 50
		rect 0 38 443 16
		textalign ITEM_ALIGN_RIGHT
		textalignx 224
		textaligny 12
		textscale .22
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
		forecolor 1 1 1 1
		visible 1
		mouseEnter { setitemcolor icr_mousesens backcolor .3 0.5 0.2 .25 ; show tip_icr_mousesens ; show tipbox }
		mouseExit { setitemcolor icr_mousesens backcolor 1 1 1 .07 ; hide tip_icr_mousesens ; hide tipbox }
		}

	itemDef {
		name icr_zoomweap
		type ITEM_TYPE_MULTI
		text "@CONTROLS_FORZOOMING"
		textfont		UI_FONT_BIG
		cvar "cg_useWeapsForZoom"
		cvarFloatList { "@GENERAL_OFF" 0 "@CONTROLS_ZOOM_ON_NORMAL" 1 "@CONTROLS_ZOOM_ON_REVERSE" 2 }
		rect 0 57 443 16
		textalign ITEM_ALIGN_RIGHT
		textalignx 224
		textaligny 12
		textscale .22
		forecolor 1 1 1 1
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
		visible 1
		mouseEnter { setitemcolor icr_zoomweap backcolor .3 0.5 0.2 .25 ; show tip_icr_zoomweap ; show tipbox }
		mouseExit { setitemcolor icr_zoomweap backcolor 1 1 1 .07 ; hide tip_icr_zoomweap ; hide tipbox }
		}

	itemDef {
		name icr_alwaysrun
		type ITEM_TYPE_MULTI
		text "@CONTROLS_ALWAYSRUN"
		textfont		UI_FONT_BIG
		cvar "cl_run"
		cvarFloatList		{ "@GENERAL_NO" 0 "@GENERAL_YES" 1 }
		rect 0 76 443 16
		textalign ITEM_ALIGN_RIGHT
		textalignx 224
		textaligny 12
		textscale .22
		forecolor 1 1 1 1
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
		visible 1
		mouseEnter { setitemcolor icr_alwaysrun backcolor .3 0.5 0.2 .25 ; show tip_icr_alwaysrun ; show tipbox }
		mouseExit { setitemcolor icr_alwaysrun backcolor 1 1 1 .07 ; hide tip_icr_alwaysrun ; hide tipbox }
		}

	itemDef {
		name icr_autoswitch
		type ITEM_TYPE_MULTI
		text "@CONTROLS_AUTOSWITCH"
		textfont		UI_FONT_BIG
		cvar "cg_autoswitch"
		cvarFloatList { "@GENERAL_OFF" 0 "@CONTROLS_AUTOSWITCH_ALWAYS" 1 "@CONTROLS_AUTOSWITCH_IFNEW" 2 "@CONTROLS_AUTOSWITCH_IFBETTER" 3 "@CONTROLS_AUTOSWITCH_NEWORBETTER" 4 "@CONTROLS_AUTOSWITCH_NEWANDBETTER" 5 }
		rect 0 95 443 16
		textalign ITEM_ALIGN_RIGHT
		textalignx 224
		textaligny 12
		textscale .22
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
		forecolor 1 1 1 1
		visible 1
		mouseEnter { setitemcolor icr_autoswitch backcolor .3 0.5 0.2 .25 ; show tip_icr_autoswitch ; show tipbox }
		mouseExit { setitemcolor icr_autoswitch backcolor 1 1 1 .07 ; hide tip_icr_autoswitch ; hide tipbox }
		}

	itemDef {
		name icr_autopickup
		type ITEM_TYPE_MULTI
		text "@CONTROLS_AUTOPICKUP"
		textfont		UI_FONT_BIG
		cvar "cg_autoactivate"
		cvarFloatList		{ "@GENERAL_NO" 0 "@GENERAL_YES" 1 }
		rect 0 114 443 16
		textalign ITEM_ALIGN_RIGHT
		textalignx 224
		textaligny 12
		textscale .22
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
		forecolor 1 1 1 1
		visible 1
		mouseEnter { setitemcolor icr_autopickup backcolor .3 0.5 0.2 .25 ; show tip_icr_autopickup ; show tipbox }
		mouseExit { setitemcolor icr_autopickup backcolor 1 1 1 .07 ; hide tip_icr_autopickup ; hide tipbox }
		}

	itemDef {
		name icr_quickmsg
		type ITEM_TYPE_MULTI
		text "@CONTROLS_QUICKMESSAGEMODE"
		textfont		UI_FONT_BIG
		cvar "cg_quickMessageAlt"
		cvarFloatList { "@CONTROLS_QUICKMSG_ALPHA" 0 "@CONTROLS_QUICKMSG_NUMERIC" 1 }
		rect 0 133 443 16
		textalign ITEM_ALIGN_RIGHT
		textalignx 224
		textaligny 12
		textscale .22
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
		forecolor 1 1 1 1
		visible 1
		mouseEnter { setitemcolor icr_quickmsg backcolor .3 0.5 0.2 .25 ; show tip_icr_quickmsg ; show tipbox }
		mouseExit { setitemcolor icr_quickmsg backcolor 1 1 1 .07 ; hide tip_icr_quickmsg ; hide tipbox }
		}

	itemDef {
		name icr_editkeyboard
		text "@CONTROLS_EDITKEYBOARD"
		type ITEM_TYPE_BUTTON
		rect 136 165 170 24
		textfont UI_FONT_BIG
		textalign ITEM_ALIGN_CENTER
		textalignx 85
		textaligny 16
		textscale .22
		style WINDOW_STYLE_FILLED
		border 1
		bordercolor .5 .5 .5 .5
		forecolor 1 1 1 1
		backcolor .1 .1 .1 .3
		visible 1
		action { play "sound/misc/kcaction.wav" ;
			close ingame_controls ;
			close ingame_options ;
			open ingame_editkeyboard ;
			uiScript loadControls }
		mouseEnter { setitemcolor icr_editkeyboard backcolor .3 0.5 0.2 .5 ; show tip_icr_editkeyboard ; show tipbox }
		mouseExit { setitemcolor icr_editkeyboard backcolor .1 .1 .1 .3 ; hide tip_icr_editkeyboard ; hide tipbox }
	}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////                        HOVER TIP BOX                    //////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	itemDef {
		name tipbox
		style WINDOW_STYLE_FILLED
		rect 0 330 443 30
		backcolor 0 0 0 .55
		visible 0
		decoration
	}

	itemDef {
		name tip_icr_invertmouse
		group grpIngameControlsTip
		style WINDOW_STYLE_EMPTY
		rect 10 330 423 30
		text "@CONTROLS_TIP_INVERTMOUSE"
		textfont UI_FONT_BIG
		textscale .2
		textalign ITEM_ALIGN_LEFT
		textalignx 0
		textaligny 20
		forecolor 1 1 1 1
		visible 0
		decoration
	}

	itemDef {
		name tip_icr_smoothmouse
		group grpIngameControlsTip
