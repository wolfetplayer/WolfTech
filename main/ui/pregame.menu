	// Survival class select - own pick, not host-gated. Also drives the player's
	// model now (see SetClassModel in g_client.c) - class replaced the old
	// cosmetic characterselect/skin picker entirely.
	itemDef {
		name classselect
		visible 1
		rect 494 285 118 16
		forecolor 1 1 1 1
		backcolor 0 0 0 0
		outlinecolor 1 1 0 .5
		textfont UI_FONT_NORMAL
		type ITEM_TYPE_MULTI
		style 0
		textstyle 6
		text "@LOBBY_CLASS"
		cvar "cl_survivalClass"
		cvarFloatList { "@CREATE_CLASS_SOLDIER" 0 "@CREATE_CLASS_MEDIC" 1 "@CREATE_CLASS_ENGINEER" 2 "@CREATE_CLASS_LIEUTENANT" 3 }
		textscale .16
		textalign ITEM_ALIGN_LEFT
		textaligny 12
		}

	itemDef {
		name invite
		text "@LOBBY_INVITEFRIENDS"
		type ITEM_TYPE_BUTTON
		textfont UI_FONT_NORMAL
		textscale .2
		style WINDOW_STYLE_FILLED
		rect 494 305 118 24
		textalign ITEM_ALIGN_CENTER
		textalignx 59
		textaligny 16
		border 1
		bordercolor .5 .5 .5 .5
		forecolor 1 1 1 1
		backcolor .3 .5 .2 .3
		visible 1
		mouseEnter { setitemcolor invite backcolor .3 .5 .2 .6 }
		mouseExit { setitemcolor invite backcolor .3 .5 .2 .3 }
		action {
			exec "steam_invite"
			}
		}

// Leave (bottom-left) / Start (bottom-right) - same spots as create.menu's own back/start buttons

