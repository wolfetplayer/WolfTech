		visible 1
		}

	// Map name doubles as the "Map" tuning control (host clicks it directly). Centering is done by the draw functions themselves via DC->textWidth, not textalign/textalignx.
	itemDef {
		name mapname_host
		type ITEM_TYPE_OWNERDRAW
		ownerdraw UI_LOBBYEDITMAP
		textfont UI_FONT_NORMAL
		textscale .2
		rect 28 278 230 14
		textalign ITEM_ALIGN_CENTER
		textaligny 11
		forecolor 1 1 1 1
		backcolor 1 1 1 .07
		style WINDOW_STYLE_FILLED
		visible 1
		cvarTest "cl_lobbyEditable"
		hidecvar { "0" }
		action {
			uiScript ApplyLobbySettings
			}
		}

	itemDef {
		name mapname_guest
		ownerdraw UI_LOBBYMAPNAME
		textfont UI_FONT_NORMAL
		textscale .2
		rect 28 278 230 14
		textalign ITEM_ALIGN_CENTER
		textaligny 11
		forecolor .9 .9 .9 1
		visible 1
		cvarTest "cl_lobbyEditable"
		hidecvar { "1" }
		}

	itemDef {
		name tuningheader
		text "@CREATE_LOBBYTUNING"
		textfont UI_FONT_NORMAL
		textalign ITEM_ALIGN_CENTER
		textalignx 115
		textaligny 14
		textscale .25
		rect 28 296 230 18
		style WINDOW_STYLE_FILLED
		border 1
		bordercolor .5 .5 .5 .5
		forecolor 1 1 1 1
		backcolor .3 .5 .2 .25
		visible 1
		decoration
		}

	// Gamemode - plain cvar-bound MULTI (create.menu's own gametype selector has no cvar so it never responds to clicks) / guest read-only.
	itemDef {
		name gamemode_host
		type ITEM_TYPE_MULTI
		text "@CREATE_GAMEMODE"
		cvar "ui_netGameType"
		cvarFloatList { "Survival" 0 "Cooperative" 1 }
		textfont UI_FONT_NORMAL
		rect 28 318 230 14
		style WINDOW_STYLE_FILLED
		textalign ITEM_ALIGN_RIGHT
		textalignx 115
		textaligny 11
		textscale .19
		backcolor 1 1 1 .07
		forecolor 1 1 1 1
		visible 1
		cvarTest "cl_lobbyEditable"
		hidecvar { "0" }
		action {
			uiScript LobbyGameTypeChanged ;
			uiScript ApplyLobbySettings
			}
		}

	itemDef {
		name gamemode_guest
		ownerdraw UI_LOBBYGAMETYPELABELED
		textfont UI_FONT_NORMAL
