#include "ui/menudef.h"

{
// PRE-GAME LOBBY - opened by cl_main.c (UIMENU_PREGAME); matches create.menu's frame with 3 columns (map+tuning, chat, players) and per-row host-editable/guest-readonly itemDef pairs gated on cvarTest "cl_lobbyEditable".

menuDef {
	name "pregame"
	visible 0
	fullscreen 1
	rect 186 0 454 480
	focusColor .9 .9 .9 1
	style 1
	border 1
	soundloop ""
	style WINDOW_STYLE_FILLED
	forecolor 0 0 0 0
	backcolor 0 0 0 0

	// ui_lobbyChatInput is cleared in C instead (_UI_SetActiveMenu's UIMENU_PREGAME case) - String_Parse() treats "" as a parse failure here.

	// Guests never visit create.menu (the only other place that loads uiInfo.mapList), so reload it here too, or their map names show as raw load names.
	onOpen {
		uiScript loadArenas
		}

	// ESC acts the same as "Leave This Lobby" instead of leaving the Steam lobby membership dangling.
	onEsc {
		uiScript LeaveLobby
		}

// Menu Background (identical to create.menu, so the transition into this menu doesn't reposition the logo/backdrop)

itemDef {
	name realrtcw_background
	style WINDOW_STYLE_SHADER
	rect -120 -9.25 917 500
	background "realrtcw_background"
	visible 1
	decoration
	}

itemDef {
	name realrtcw_logo
	style WINDOW_STYLE_SHADER
	rect -107 0 480 480
	background "ui/assets/realrtcw_logo.tga"
	visible 1
	decoration
	}

// End of Menu Background

// Start of Lobby window (same border/fill as create.menu's own content window)

	itemDef {
		name window
		rect 20 115 600 325
		style WINDOW_STYLE_FILLED
		border 1
		bordercolor .5 .5 .5 .5
		forecolor 1 1 1 1
		backcolor 0 0 0 .5
		visible 1
		decoration
		}

	itemDef {
		name leadername
		ownerdraw UI_LOBBYLEADERNAME
		textfont UI_FONT_NORMAL
		textscale .2
		rect 28 117 230 14
		textalign ITEM_ALIGN_LEFT
		textaligny 11
		forecolor .8 .8 .8 1
		visible 1
		}

	// Plain lobby name (sv_hostname mirrored via cl_lobbyName) - unset "text" makes Item_Text_Paint() show the raw cvar value directly.
	itemDef {
		name lobbyname
		cvar "cl_lobbyName"
		textfont UI_FONT_NORMAL
		textscale .22
		rect 266 117 220 14
		textalign ITEM_ALIGN_CENTER
		textalignx 110
		textaligny 11
		forecolor .9 .9 .9 1
		visible 1
		decoration
		}

// Column headers

	itemDef {
		name mapheader
		text "@CREATE_MAPSELECTION"
		textfont UI_FONT_NORMAL
		textalign ITEM_ALIGN_CENTER
		textalignx 115
		textaligny 14
		textscale .25
		rect 28 134 230 20
		style WINDOW_STYLE_FILLED
		border 1
		bordercolor .5 .5 .5 .5
		forecolor 1 1 1 1
		backcolor .3 .5 .2 .25
		visible 1
		decoration
		}

	itemDef {
		name chatheader
		text "@LOBBY_CHAT"
