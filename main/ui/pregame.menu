		text "@LOBBY_LEAVE"
		type ITEM_TYPE_BUTTON
		textfont UI_FONT_NORMAL
		style 0
		textstyle 6
		rect 30 450 90 14
		textalign ITEM_ALIGN_LEFT
		textscale .255
		textalignx 6
		textaligny 12
		forecolor .9 .9 .9 .9
		visible 1
		mouseEnter { setitemcolor leave forecolor .6 .6 .6 .6 }
		mouseExit { setitemcolor leave forecolor .9 .9 .9 .9 }
		action {
			uiScript LeaveLobby
			}
		}

	itemDef {
		name startgame
		text "@LOBBY_STARTGAME"
		type ITEM_TYPE_BUTTON
		textfont UI_FONT_NORMAL
		style 0
		textstyle 6
		rect 510 450 120 14
		textalign ITEM_ALIGN_LEFT
		textscale .255
		textalignx 5
		textaligny 12
		forecolor .9 .9 .9 .9
		visible 1
		cvarTest "cl_lobbyEditable"
		hidecvar { "0" }
		mouseEnter { setitemcolor startgame forecolor .6 .6 .6 .6 }
		mouseExit { setitemcolor startgame forecolor .9 .9 .9 .9 }
		action {
			exec "lobby_countdown_start"
			}
		}

	// Same spot as startgame - cl_lobbyEditable shows Start, cl_lobbyCounting shows Stop.
	itemDef {
		name stopgame
		text "@LOBBY_STOPGAME"
		type ITEM_TYPE_BUTTON
		textfont UI_FONT_NORMAL
		style 0
		textstyle 6
		rect 510 450 120 14
		textalign ITEM_ALIGN_LEFT
		textscale .255
		textalignx 5
		textaligny 12
		forecolor .9 .9 .9 .9
		visible 1
		cvarTest "cl_lobbyCounting"
		hidecvar { "0" }
		mouseEnter { setitemcolor stopgame forecolor .6 .6 .6 .6 }
		mouseExit { setitemcolor stopgame forecolor .9 .9 .9 .9 }
		action {
			exec "lobby_countdown_stop"
			}
		}

	}
}
