					forecolor			.6 .6 .6 .6
					visible				1
					type				ITEM_TYPE_BUTTON
					//border 1
					//bordercolor 1 1 1 1
					mouseExit {
						hide message_start ;
						hide start_alt ;
						show start }
					action {
						close create_menu ;
						uiScript StartServer
					}
					}

// End of Create Server

// Start of BACK Button


		itemDef {
			name gotobar
			style 2
			rect 0 453 640 20
			textscale 0.4
			textalign 0		// center
			textalignx 60        	// x alignment point for text
			 // use it to offset left/right text from the edge
			 // or to center the text on a different point
			textaligny 21
			style 2
			border 4
			bordercolor 0.5 0.5 0.5 0.0
			bordersize 2
			backcolor 0.5 0.5 .5 0.0
			visible 1
			mouseEnter { setcolor backcolor .5 0.5 0.5 .5 }
			mouseExit { setcolor backcolor .5 .5 .5 .0 }
			decoration
			}

		itemDef {
			name back
			text "@GENERAL_MAIN_MENU"
			type 1
			style 0
			textstyle 6
			rect 30 458 90 14
			textalign 0
			textfont UI_FONT_NORMAL
			textscale .255
			textalignx 6
			textaligny 12
			forecolor .9 .9 .9 .9
			visible 1
			action {
			close create_menu ;
			open main }

			mouseEnter {
			hide back ;
			show back_alt ;
			show message_back
			}
			}

		itemDef {
			name back_alt
			text "@GENERAL_MAIN_MENU"
			type 1
			style 0
			textstyle 6
			rect 30 458 90 14
			textalign 0
			textfont UI_FONT_NORMAL
			textscale .255
			textalignx 6
			textaligny 12
			forecolor .6 .6 .6 .6
			visible 1
			type ITEM_TYPE_BUTTON
			action {
			hide grpControls ;
			close create_menu ;
			open main }

			mouseExit {
			hide back_alt ;
			show back ;
			hide message_back }
			}

// End of BACK Button

