#include "ui/menudef.h"

{
// MAIN WINDOW

  menuDef {
    	name "create_menu"
    	visible 0
    	fullscreen 1
    	rect 186 0 454 480
		focusColor 1 .75 0 1
    	style 1
    	border 1
		soundloop ""
      	style WINDOW_STYLE_FILLED
		forecolor 0 0 0 0
		backcolor 0 0 0 0

	onOpen {
		setitemcolor fadebox backcolor 0 0 0 1 ;
		fadeout fadebox ;
		hide back_alt ;
		show back ;
		show grpCreate ;
		hide grpmessage ;
		hide tipbox ;
		hide grpCreateTip ;
		setitemcolor easy backcolor .7 .7 .0 .25 ;
		uiScript skilleasy
	}

	onEsc {
		close create_menu ;
		open main
	}

// Start of Menu Background

itemDef
	{
		name realrtcw_background
		style WINDOW_STYLE_SHADER
		rect -120 -9.25 917 500
		background "realrtcw_background"
		visible 1
		decoration
	}

itemDef
	{
		name realrtcw_logo
		style WINDOW_STYLE_SHADER
		rect -107 0 480 480
		background "ui/assets/realrtcw_logo.tga"
		visible 1
		decoration
	}

