  menuDef {
    	name "create_menu"
    	visible 0
    	fullscreen 1
    	rect 186 0 454 480	
		focusColor .9 .9 .9 1
    	style 1
    	border 1
		soundloop ""
      	style WINDOW_STYLE_FILLED
		forecolor 0 0 0 0
		backcolor 0 0 0 0

	onOpen {
		setitemcolor fadebox backcolor 0 0 0 1 ; 
		fadeout fadebox ;
		hide back_alt ;
		show back ;
		show grpCreate ;
		hide grpmessage ;
		setitemcolor easy backcolor .7 .7 .0 .25 ;
		uiScript skilleasy
	}

	onEsc {
		close create_menu ;
		open main
	}

