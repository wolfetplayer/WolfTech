#include "ui/menudef.h"

{
\\ SETUP MENU \\

menuDef {
		name "ingame_options"
		visible 0
		fullscreen 0
		outOfBoundsClick			// this closes the window if it gets a click out of the rectangle
		rect 220 125 443 340
		focusColor 1 .75 0 1
		style 1
		border 1
		onopen { close ingame_system ; close ingame_controls ; close ingame_callvote ; hide grpOptions ; hide hitfeedback ; show performance ; setitemcolor ctr_hud backcolor .3 0.5 0.2 .25 ; setitemcolor ctr_hitfeedback backcolor .1 .1 .1 .25 }



itemDef
	{
	name window
	group ingamebox
	rect 0 2 443 300
	style WINDOW_STYLE_FILLED
	border 1
	bordercolor .5 .5 .5 .5
	forecolor 1 1 1 1
	backcolor 0 0 0 .5
	visible 1
	decoration
	}

//////// START OF PASTE

itemDef {
		name ctr_hud
		group grpOptionsTab
		text "@OPTIONS_HUDSETTINGS"
		textfont UI_FONT_BIG
		type ITEM_TYPE_BUTTON
		textalign ITEM_ALIGN_CENTER
		textalignx 72
		textaligny 14
		textscale .23
		rect 82 15 145 20
		style WINDOW_STYLE_FILLED
		border			1
		bordercolor		.5 .5 .5 .5
		forecolor		1 1 1 1
		backcolor		.3 0.5 0.2 .25
		visible			1
		action { play "sound/misc/kcaction.wav" ; hide hitfeedback ; show performance ; setitemcolor ctr_hud backcolor .3 0.5 0.2 .25 ; setitemcolor ctr_hitfeedback backcolor .1 .1 .1 .25 }
	}

	itemDef {
		name ctr_hitfeedback
		group grpOptionsTab
		text "@OPTIONS_HITFEEDBACK"
		textfont UI_FONT_BIG
		type ITEM_TYPE_BUTTON
		textalign ITEM_ALIGN_CENTER
		textalignx 72
		textaligny 14
		textscale .23
		rect 227 15 145 20
		style WINDOW_STYLE_FILLED
		border			1
		bordercolor		.5 .5 .5 .5
		forecolor		1 1 1 1
		backcolor		.1 .1 .1 .25
		visible			1
		action { play "sound/misc/kcaction.wav" ; hide performance ; show hitfeedback ; setitemcolor ctr_hitfeedback backcolor .3 0.5 0.2 .25 ; setitemcolor ctr_hud backcolor .1 .1 .1 .25 }
	}

	itemDef {
		name performance
		group grpOptions
		type ITEM_TYPE_SLIDER
		text "@OPTIONS_HUDALPHA"
		textfont		UI_FONT_BIG
		cvarfloat "cg_hudAlpha" .6 0 1
		rect 82 40 290 12
      	textalign ITEM_ALIGN_RIGHT
      	textalignx 142
      	textaligny 10
		textscale .23
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07        
      	forecolor 1 1 1 1
      	visible 0
   	}	
	
	itemDef {
		name performance				
		type ITEM_TYPE_MULTI	
		group grpOptions
		text "@OPTIONS_CURSORHINTS"
		textfont		UI_FONT_BIG
		cvar "cg_cursorHints"
		cvarFloatList { "@OPTIONS_CURSORHINTS_STROBE" 2 "@OPTIONS_CURSORHINTS_ALPHA" 3 "@OPTIONS_CURSORHINTS_SOLID" 4 "@OPTIONS_CURSORHINTS_OFF" 0 "@OPTIONS_CURSORHINTS_SIZE" 1 }
		textalign ITEM_ALIGN_RIGHT
		rect 82 55 290 12
		textalign ITEM_ALIGN_RIGHT
		textalignx 142
		textaligny 10
		textscale .23
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
		forecolor 1 1 1 1
		visible 0
	}

