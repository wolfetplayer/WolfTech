#include "ui/menudef.h"

{
\\ INGAME OPTIONS SHELL (horizontal tab bar, mirrors main menu setup.menu) \\

menuDef {
		name "ingame_options"
		visible 0
		fullscreen 0
		outOfBoundsClick			// this closes the window if it gets a click out of the rectangle
		rect 220 78 443 402
		focusColor 1 .75 0 1
		style 1
		border 1
		onopen { close ingame_join ; close ingame_callvote }

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////                        CONTENT PANEL                    //////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

itemDef
	{
	name panelborder
	group ingamebox
	rect -2 0 447 402
	style WINDOW_STYLE_ROUNDED
	cornerradius 10
	backcolor 1 1 1 .4
	visible 1
	decoration
	}

itemDef
	{
	name window
	group ingamebox
	rect 0 2 443 398
	style WINDOW_STYLE_ROUNDED
	cornerradius 8
	forecolor 1 1 1 1
	backcolor 0 0 0 .88
	visible 1
	decoration
	}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////                        TAB BAR                          //////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

itemDef {
		name itab_gameplay
		group grpIngameOptionsTab
		text "@MAIN_GAMEPLAY"
		textfont UI_FONT_BIG
		type ITEM_TYPE_BUTTON
		textalign ITEM_ALIGN_CENTER
		textalignx 54
		textaligny 15
		textscale .22
		rect 2 8 108 20
		style WINDOW_STYLE_FILLED
		border			1
		bordercolor		.5 .5 .5 .5
		forecolor		1 1 1 1
		backcolor		.3 0.5 0.2 .5
		visible			1
		action { play "sound/misc/kcaction.wav" ;
		close ingame_controls ; close ingame_editkeyboard ; close ingame_system ; close ingame_sound ;
		open ingame_gameplay ;
		setitemcolor itab_gameplay backcolor .3 0.5 0.2 .5 ; setitemcolor itab_controls backcolor .05 .05 .05 .65 ; setitemcolor itab_graphics backcolor .05 .05 .05 .65 ; setitemcolor itab_sound backcolor .05 .05 .05 .65 }
	}

	itemDef {
		name itab_controls
		group grpIngameOptionsTab
		text "@MAIN_CONTROLS"
		textfont UI_FONT_BIG
		type ITEM_TYPE_BUTTON
		textalign ITEM_ALIGN_CENTER
		textalignx 54
		textaligny 15
		textscale .22
		rect 112 8 108 20
		style WINDOW_STYLE_FILLED
		border			1
		bordercolor		.5 .5 .5 .5
		forecolor		1 1 1 1
		backcolor		.05 .05 .05 .65
		visible			1
		action { play "sound/misc/kcaction.wav" ;
		close ingame_gameplay ; close ingame_editkeyboard ; close ingame_system ; close ingame_sound ;
		open ingame_controls ;
		setitemcolor itab_controls backcolor .3 0.5 0.2 .5 ; setitemcolor itab_gameplay backcolor .05 .05 .05 .65 ; setitemcolor itab_graphics backcolor .05 .05 .05 .65 ; setitemcolor itab_sound backcolor .05 .05 .05 .65 }
	}

	itemDef {
		name itab_graphics
		group grpIngameOptionsTab
		text "@SYSTEM_GRAPHICS"
		textfont UI_FONT_BIG
		type ITEM_TYPE_BUTTON
		textalign ITEM_ALIGN_CENTER
		textalignx 54
		textaligny 15
		textscale .22
		rect 222 8 108 20
		style WINDOW_STYLE_FILLED
		border			1
		bordercolor		.5 .5 .5 .5
		forecolor		1 1 1 1
		backcolor		.05 .05 .05 .65
		visible			1
		action { play "sound/misc/kcaction.wav" ;
		close ingame_gameplay ; close ingame_controls ; close ingame_editkeyboard ; close ingame_sound ;
		open ingame_system ;
		setitemcolor itab_graphics backcolor .3 0.5 0.2 .5 ; setitemcolor itab_gameplay backcolor .05 .05 .05 .65 ; setitemcolor itab_controls backcolor .05 .05 .05 .65 ; setitemcolor itab_sound backcolor .05 .05 .05 .65 }
	}

	itemDef {
		name itab_sound
		group grpIngameOptionsTab
		text "@SYSTEM_SOUND"
		textfont UI_FONT_BIG
		type ITEM_TYPE_BUTTON
		textalign ITEM_ALIGN_CENTER
		textalignx 54
		textaligny 15
		textscale .22
		rect 332 8 108 20
		style WINDOW_STYLE_FILLED
		border			1
		bordercolor		.5 .5 .5 .5
		forecolor		1 1 1 1
		backcolor		.05 .05 .05 .65
		visible			1
		action { play "sound/misc/kcaction.wav" ;
		close ingame_gameplay ; close ingame_controls ; close ingame_editkeyboard ; close ingame_system ;
		open ingame_sound ;
		setitemcolor itab_sound backcolor .3 0.5 0.2 .5 ; setitemcolor itab_gameplay backcolor .05 .05 .05 .65 ; setitemcolor itab_controls backcolor .05 .05 .05 .65 ; setitemcolor itab_graphics backcolor .05 .05 .05 .65 }
	}

}

}
