		mouseEnter { setitemcolor isys_videomode backcolor .3 0.5 0.2 .25 ; show tip_isys_videomode ; show tipbox }
		mouseExit { setitemcolor isys_videomode backcolor 1 1 1 .07 ; hide tip_isys_videomode ; hide tipbox }
    		}

