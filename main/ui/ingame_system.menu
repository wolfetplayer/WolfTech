	itemDef {
		name graphics
		group grpSystem
		type ITEM_TYPE_MULTI
		text "@SYSTEM_RENDERER"
		textfont		UI_FONT_BIG
		cvar "cl_renderer"
		cvarStrList { "@SYSTEM_RENDERER_OPENGL1", "opengl1", "@SYSTEM_RENDERER_REND2", "rend2"  }
		rect 82 27 290 12
		textalign ITEM_ALIGN_RIGHT
		textalignx 142
		textaligny 10
		textscale .22  
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07      
		forecolor 1 1 1 1
		visible 0 
		action { uiScript glCustom }
		}


	itemDef {
		name graphics				
		group grpSystem
		type ITEM_TYPE_MULTI
		text "@SYSTEM_QUALITY"
		textfont		UI_FONT_BIG
		cvar "ui_glCustom"
		cvarFloatList { "@SYSTEM_LEVEL_HIGHQUALITY" 0 "@SYSTEM_LEVEL_NORMAL" 1 "@SYSTEM_LEVEL_FAST" 2 "@SYSTEM_LEVEL_FASTEST" 3 "@SYSTEM_LEVEL_CUSTOM" 4 }

		cvarTest		"ui_glCustom"
		hideCvar		{ "999" }	// 999 is 'recommended'

 		rect 82 42 290 12
   		textalign ITEM_ALIGN_RIGHT
   		textalignx 142 
   		textaligny 10
		textscale .23
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07         
   		forecolor 1 1 1 1
   		visible 0 
		action {
			 uiScript update "ui_glCustom" }
    		}


	itemDef {
		name graphics				
		group grpSystem
		text "@SYSTEM_QUALITY_RECOMMENDED"
		textfont		UI_FONT_BIG
		type ITEM_TYPE_BUTTON	

		cvarTest		"ui_glCustom"
		showCvar		{ "999" }	// 999 is 'recommended'

		rect 82 42 290 12
		textalign ITEM_ALIGN_CENTER
		textalignx 162 
		textaligny 10
		textscale .22
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
		forecolor 1 1 1 1
		visible 0
		action {
			setcvar ui_glCustom 0;	// 'recommended'
			uiScript update "ui_glCustom" }
		}

