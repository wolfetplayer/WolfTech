		mouseenter { setitemcolor isys_brightness backcolor .3 0.5 0.2 .25 ; show brightness_apply_message ; show tip_isys_brightness ; show tipbox }
		mouseexit { setitemcolor isys_brightness backcolor 1 1 1 .07 ; hide brightness_apply_message ; hide tip_isys_brightness ; hide tipbox }
		}

itemDef {
		name graphicsapply
		text "@SYSTEM_APPLY"
		textfont		UI_FONT_BIG
		type 1
		textscale .25
		style WINDOW_STYLE_FILLED
		group grpsystem
		rect 171 140 100 20
		textalign 1
		textalignx 50
		textaligny 15
		forecolor 1 1 1 1
		backcolor .1 .1 .1 .1
		visible 1
		border 1
		bordercolor .5 .5 .5 .5
		action { play "sound/misc/kcaction.wav" ;
open in_vid_restart_popmenu ; hide graphics ; hide graphicsapply ; hide tipbox ; hide grpIngameSystemTip }
		mouseEnter { setitemcolor graphicsapply backcolor .3 .5 .2 .25 ; show tip_graphicsapply ; show tipbox }
      	mouseExit { setitemcolor graphicsapply backcolor .1 .1 .1 .1 ; hide tip_graphicsapply ; hide tipbox }
		}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////                        SUB-SECTION NAV ROWS             //////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

itemDef {
	name tab_advanced
	group grpIngameGraphicsNav
	text "@SYSTEM_ADVANCED"
	textfont UI_FONT_BIG
	type ITEM_TYPE_BUTTON
	textalign ITEM_ALIGN_CENTER
	textalignx 221
	textaligny 14
	textscale .24
	rect 0 166 443 20
	style WINDOW_STYLE_FILLED
	backcolor 1 1 1 .07
	forecolor 1 1 1 1
	visible 1
	action { play "sound/misc/kcaction.wav" ;
	hide graphics ; hide graphicsapply ; hide grpIngameGraphicsNav ; hide tipbox ; hide grpIngameSystemTip ;
	show advanced }
	mouseEnter { setitemcolor tab_advanced backcolor .3 0.5 0.2 .25 ; show tip_tab_advanced ; show tipbox }
	mouseExit { setitemcolor tab_advanced backcolor 1 1 1 .07 ; hide tip_tab_advanced ; hide tipbox }
	}

itemDef {
	name tab_performance
	group grpIngameGraphicsNav
	text "@SYSTEM_PERFORMANCE"
	textfont UI_FONT_BIG
