itemDef {
	name rend2apply
	text "@SYSTEM_APPLY"
	textfont		UI_FONT_BIG
	type 1
	style WINDOW_STYLE_FILLED
	group rend2apply
	textscale .25
	rect 112 340 100 22
	textalign 1
	textalignx 50
	textaligny 16
	forecolor 1 1 1 1
	backcolor .1 .1 .1 .1
	visible 0
	border 1
	bordercolor .5 .5 .5 .5
	action { play "sound/misc/kcaction.wav" ;
	open in_vid_restart_popmenu ; hide rend2page ; hide rend2apply }
	mouseEnter { setitemcolor rend2apply backcolor .3 .5 .2 .25 ; show tip_rend2apply ; show tipbox }
	mouseExit { setitemcolor rend2apply backcolor .1 .1 .1 .1 ; hide tip_rend2apply ; hide tipbox }
	}

