itemDef {
	name rend2nav1
	group rend2nav
	text "@SYSTEM_REND2_MATERIALS"
	textfont		UI_FONT_BIG
	type ITEM_TYPE_BUTTON
	textscale .19
	style WINDOW_STYLE_FILLED
	rect 2 283 145 14
	textalign ITEM_ALIGN_CENTER
	textalignx 72
	textaligny 11
	forecolor 1 1 1 1
	backcolor .1 .1 .1 .1
	border 1
	bordercolor .5 .5 .5 .5
