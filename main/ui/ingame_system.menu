itemDef {
	name ctr_rend2
	text "@SYSTEM_REND2"
	textfont		UI_FONT_BIG
	type 1
	textscale .23
	group grpControlbutton
	rect 125 10 100 12
	textalign 1
	textalignx 50
	textaligny 10
	forecolor 1 1 1 1
	backcolor .1 .1 .1 0
	visible 1
	action { hide grpSystem ; hide graphicsapply ;
	show rend2p1 ; hide rend2p2 ; hide rend2p3 ; show rend2nav ; show rend2apply }
	mouseEnter { setitemcolor ctr_rend2 backcolor .1 .37 .1 1 }
	mouseExit { setitemcolor ctr_rend2 backcolor .37 .1 .1 1 }
	}


