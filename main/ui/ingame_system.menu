	itemDef {
		cvarTest "r_ignorehwgamma"

		name isys_brightness
		group graphics
		type ITEM_TYPE_SLIDER
		text "@SYSTEM_BRIGHTNESS_LABEL"
		textfont		UI_FONT_BIG
		cvarfloat "r_gamma" 1.3 .5 3
		rect 0 114 443 16
		textalign ITEM_ALIGN_RIGHT
		textalignx 224
		textaligny 12
		textscale .22
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
		forecolor 1 1 1 1
		visible 0
