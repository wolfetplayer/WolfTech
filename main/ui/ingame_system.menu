#include "ui/menudef.h"

{
\\ SYSTEM MENU \\

menuDef {
    	name "ingame_system"
    	visible 0
    	fullscreen 0
		rect 220 110 443 366
    	focusColor 1 .75 0 1
    	style 1
    	border 1

		onopen { hide advanced ; hide performance ; hide rend2page ; hide rend2apply ; show graphics ; show graphicsapply ; show grpIngameGraphicsNav ; hide tipbox ; hide grpIngameSystemTip }

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////                        GRAPHICS (NORMAL)                 //////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	itemDef {
		name isys_renderer
		group graphics
		type ITEM_TYPE_MULTI
		text "@SYSTEM_RENDERER"
		textfont		UI_FONT_BIG
		cvar "cl_renderer"
		cvarStrList { "@SYSTEM_RENDERER_OPENGL1", "opengl1", "@SYSTEM_RENDERER_REND2", "rend2"  }
		rect 0 0 443 16
		textalign ITEM_ALIGN_RIGHT
		textalignx 224
		textaligny 12
		textscale .22
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
		forecolor 1 1 1 1
		visible 0
		action { uiScript glCustom }
		mouseEnter { setitemcolor isys_renderer backcolor .3 0.5 0.2 .25 ; show tip_isys_renderer ; show tipbox }
		mouseExit { setitemcolor isys_renderer backcolor 1 1 1 .07 ; hide tip_isys_renderer ; hide tipbox }
		}

	itemDef {
		name isys_quality
		group graphics
		type ITEM_TYPE_MULTI
		text "@SYSTEM_QUALITY"
		textfont		UI_FONT_BIG
		cvar "ui_glCustom"
		cvarFloatList { "@SYSTEM_LEVEL_HIGHQUALITY" 0 "@SYSTEM_LEVEL_NORMAL" 1 "@SYSTEM_LEVEL_FAST" 2 "@SYSTEM_LEVEL_FASTEST" 3 "@SYSTEM_LEVEL_CUSTOM" 4 }

		cvarTest		"ui_glCustom"
		hideCvar		{ "999" }	// 999 is recommended

		rect 0 19 443 16
		textalign ITEM_ALIGN_RIGHT
		textalignx 224
		textaligny 12
		textscale .22
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
		forecolor 1 1 1 1
		visible 0
		action {
			 uiScript update "ui_glCustom" }
		mouseEnter { setitemcolor isys_quality backcolor .3 0.5 0.2 .25 ; show tip_isys_quality ; show tipbox }
		mouseExit { setitemcolor isys_quality backcolor 1 1 1 .07 ; hide tip_isys_quality ; hide tipbox }
    		}

	itemDef {
		name isys_quality_recommended
		group graphics
		text "@SYSTEM_QUALITY_RECOMMENDED"
		textfont		UI_FONT_BIG
		type ITEM_TYPE_BUTTON

		cvarTest		"ui_glCustom"
		showCvar		{ "999" }	// 999 is recommended

		rect 0 19 443 16
		textalign ITEM_ALIGN_CENTER
		textalignx 244
		textaligny 12
		textscale .22
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
		forecolor 1 1 1 1
		visible 0
		action {
			setcvar ui_glCustom 0;	// recommended
			uiScript update "ui_glCustom" }
		mouseEnter { setitemcolor isys_quality_recommended backcolor .3 0.5 0.2 .25 ; show tip_isys_quality_recommended ; show tipbox }
		mouseExit { setitemcolor isys_quality_recommended backcolor 1 1 1 .07 ; hide tip_isys_quality_recommended ; hide tipbox }
		}

		itemDef {
		name isys_videomode
		group graphics
		type ITEM_TYPE_COMBO
		text "@SYSTEM_VIDEOMODE_LABEL"
		textfont		UI_FONT_BIG
		cvar "r_mode"
		cvarFloatList {  "@INGAME_SYSTEM_VM_640X480" 3 "@INGAME_SYSTEM_VM_800X600" 4 "@INGAME_SYSTEM_VM_960X720" 5 "@INGAME_SYSTEM_VM_1024X768" 6 "@INGAME_SYSTEM_VM_1152X864" 7 "@INGAME_SYSTEM_VM_1280X1024" 8 "@INGAME_SYSTEM_VM_1600X1200" 9 "@INGAME_SYSTEM_VM_2048X1536" 10 "@INGAME_SYSTEM_VM_WIDESCREEN" 11 }
		rect 0 38 443 16
