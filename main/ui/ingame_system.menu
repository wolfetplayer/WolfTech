itemDef {
	name rend2apply
	text "@SYSTEM_APPLY"
	textfont		UI_FONT_BIG
	type 1
	style WINDOW_STYLE_FILLED
	group rend2apply
	textscale .25
	rect 181 302 100 20
	textalign 1
	textalignx 50
	textaligny 15
	forecolor 1 1 1 1
	backcolor .1 .1 .1 .1
	visible 0
	border 1
	bordercolor .5 .5 .5 .5
	action { play "sound/misc/kcaction.wav" ;
	open in_vid_restart_popmenu ; hide rend2p1 ; hide rend2p2 ; hide rend2p3 ; hide rend2nav ; hide rend2apply }
	mouseEnter { setitemcolor rend2apply backcolor .3 .5 .2 .25 }
	mouseExit { setitemcolor rend2apply backcolor .1 .1 .1 .1 }
	}


	itemDef {
		name ctr_driver
		text "@INGAME_SYSTEM_DRIVERINFO"
		textfont		UI_FONT_BIG
		type 1
		textscale .23
		group grpControlbutton
		rect 232 10 100 12
		textalign 1
		textalignx 50
		textaligny 10
		forecolor 1 1 1 1
		backcolor .1 .1 .1 0
		visible 1
		action { hide grpSystem ; hide graphicsapply ; hide rend2p1 ; hide rend2p2 ; hide rend2p3 ; hide rend2nav ; hide rend2apply ; show driver }
		mouseEnter { setitemcolor ctr_driver backcolor .1 .37 .1 1 }
		mouseExit { setitemcolor ctr_driver backcolor .37 .1 .1 1 }
	}


 	
