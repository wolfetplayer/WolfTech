			rect 0 130 270 12
			textfont UI_FONT_NORMAL
			textalign ITEM_ALIGN_RIGHT
			textalignx 96
			textaligny 11
			textscale .22
			style WINDOW_STYLE_FILLED
			backcolor   1 1 1 .07
			forecolor 1 1 1 1
			visible 1
			mouseEnter { setitemcolor iq_musicvolume backcolor .3 0.5 0.2 .25 }
			mouseExit { setitemcolor iq_musicvolume backcolor 1 1 1 .07 }
			}
			
		itemDef {
			name iq_hudalpha
			type ITEM_TYPE_SLIDER
			text "@OPTIONS_HUDALPHA"
			cvarfloat "cg_hudAlpha" .6 .1 1
			rect 0 150 270 12
			textfont UI_FONT_NORMAL
			textalign ITEM_ALIGN_RIGHT
			textalignx 96
			textaligny 11
			textscale .22
			style WINDOW_STYLE_FILLED
			backcolor   1 1 1 .07
			forecolor 1 1 1 1
			visible 1
			mouseEnter { setitemcolor iq_hudalpha backcolor .3 0.5 0.2 .25 }
			mouseExit { setitemcolor iq_hudalpha backcolor 1 1 1 .07 }
			}

		itemDef {
			name iq_crosshairalpha
			type ITEM_TYPE_SLIDER
			text "@OPTIONS_CROSSHAIRALPHA"
			cvarfloat "cg_crosshairAlpha" .6 .1 1
			rect 0 165 270 12
			textfont UI_FONT_NORMAL
			textalign ITEM_ALIGN_RIGHT
			textalignx 96
			textaligny 11
			textscale .22
			style WINDOW_STYLE_FILLED
			backcolor   1 1 1 .07
			forecolor 1 1 1 1
			visible 1
			mouseEnter { setitemcolor iq_crosshairalpha backcolor .3 0.5 0.2 .25 }
			mouseExit { setitemcolor iq_crosshairalpha backcolor 1 1 1 .07 }
			}

		itemDef {
			name iq_sensitivity
			group grpControls
			type ITEM_TYPE_SLIDER
			text "@QUICK_SENSITIVITY"
			cvarfloat "sensitivity" 5 1 30
			rect 0 180 270 12
			textfont UI_FONT_NORMAL
			textalign ITEM_ALIGN_RIGHT
			textalignx 96
			textaligny 11
			textscale .22
			style WINDOW_STYLE_FILLED
			backcolor   1 1 1 .07           
			forecolor 1 1 1 1
			visible 1
			mouseEnter { setitemcolor iq_sensitivity backcolor .3 0.5 0.2 .25 }
			mouseExit { setitemcolor iq_sensitivity backcolor 1 1 1 .07 }
			}
						
		itemDef {
			name quick
			text "@OPTIONS_CROSSHAIR"
			type 1
			rect 90 195 60 12
			textfont UI_FONT_NORMAL
			textalign ITEM_ALIGN_CENTER
			textalignx 130
			textaligny 11
			textscale .22
			forecolor 1 1 1 1
			visible 1 
			decoration
			}

		itemDef {
			name quick
			rect 195 210 50 50
			ownerdraw UI_CROSSHAIR
			textalign ITEM_ALIGN_LEFT
			textalignx 0
			textaligny 50
			style WINDOW_STYLE_FILLED
			backcolor   1 1 1 .07
			forecolor 1 1 1 1
			visible 1
			}

		itemDef {
			name			iq_crosshairnames
			rect			0 209 170 12
			textfont		UI_FONT_NORMAL
			type			ITEM_TYPE_MULTI
			style			WINDOW_STYLE_FILLED
			text			"@OPTIONS_CROSSHAIRNAMES"
			cvar			"cg_drawcrosshairnames"
			cvarFloatList	{ "@GENERAL_OFF" 0 "@GENERAL_ON" 1}
			textscale		.22
			textalign		ITEM_ALIGN_RIGHT	
			textalignx		96
			textaligny		11
			backcolor		  1 1 1 .07 		  
			forecolor		1 1 1 1
			visible			1
			mouseEnter { setitemcolor iq_crosshairnames backcolor .3 0.5 0.2 .25 }
			mouseExit { setitemcolor iq_crosshairnames backcolor 1 1 1 .07 }
			}
		
		itemDef {
			name			iq_teamoverlay
			rect			0 224 170 12
			textfont		UI_FONT_NORMAL
			type			ITEM_TYPE_MULTI
			style			WINDOW_STYLE_FILLED
			text			"@OPTIONS_TEAMOVERLAY"
			cvar			"cg_drawteamoverlay"
			cvarFloatList	{ "@GENERAL_OFF" 0 "@GENERAL_ON" 1}
			textscale		.22
			textalign		ITEM_ALIGN_RIGHT	
			textalignx		96
			textaligny		11
			backcolor		  1 1 1 .07 		  
			forecolor		1 1 1 1
			visible			1
			mouseEnter { setitemcolor iq_teamoverlay backcolor .3 0.5 0.2 .25 }
			mouseExit { setitemcolor iq_teamoverlay backcolor 1 1 1 .07 }
			}

		itemDef {
			name			iq_compass
			rect			0 239 170 12
			textfont		UI_FONT_NORMAL
			type			ITEM_TYPE_MULTI
			style			WINDOW_STYLE_FILLED
			text			"@OPTIONS_COMPASS"
			cvar			"cg_drawcompass"
			cvarFloatList	{ "@GENERAL_OFF" 0 "@GENERAL_ON" 1}
			textscale		.22
			textalign		ITEM_ALIGN_RIGHT	
			textalignx		96
			textaligny		11
			backcolor		  1 1 1 .07 		  
			forecolor		1 1 1 1
			visible			1
			mouseEnter { setitemcolor iq_compass backcolor .3 0.5 0.2 .25 }
			mouseExit { setitemcolor iq_compass backcolor 1 1 1 .07 }
			}


		itemDef {
			name                    joingame
			text                    "@QUICK_JOINGAME"
			type                    ITEM_TYPE_BUTTON
			textscale               .25 
			style                   WINDOW_STYLE_FILLED    
			border                  1   
			bordercolor               1 1 1 .3
			rect					3 267 130 20
			textalign               ITEM_ALIGN_CENTER
			textalignx              65              // center
			textaligny              14
			textfont                UI_FONT_NORMAL
			backcolor               .1 .1 .1 .3
			forecolor               1 1 1 1
			visible                 1
			action                  { exec "cmd team free" ; uiScript closeingame }
			mouseEnter              { setitemcolor joingame backcolor .3 0.5 0.2 .5 }
			mouseExit               { setitemcolor joingame backcolor .1 .1 .1 .3 }
			}

		itemDef {
			name                    joinspec
			text                    "@QUICK_JOINSPECTATORS"
			type                    ITEM_TYPE_BUTTON
			textscale               .25 
			style                   WINDOW_STYLE_FILLED    
			border                  1   
			bordercolor               1 1 1 .3
			rect					137 267 130 20
			textalign               ITEM_ALIGN_CENTER
			textalignx              65             // center
			textaligny              14  
			textfont                UI_FONT_NORMAL
			backcolor               .1 .1 .1 .3
			forecolor               1 1 1 1
			visible                 1
			action                  { exec "cmd team s" ; uiScript closeingame }
			mouseEnter              { setitemcolor joinspec backcolor .3 0.5 0.2 .5 }
			mouseExit               { setitemcolor joinspec backcolor .1 .1 .1 .3 }
			}

}

}
