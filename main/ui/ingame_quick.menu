#include "ui/menudef.h"
{

\\ INGAME_QUICK MENU \\

menuDef {
	name "ingame_quick"
	visible 0
	fullScreen 0
	outOfBoundsClick			// this closes the window if it gets a click out of the rectangle
	rect 328 110 270 290
	focusColor 1 .75 0 1
	disableColor .5 .5 .5 1



	itemDef {
		name panelborder
		rect -2 -2 274 294
		style WINDOW_STYLE_ROUNDED
		cornerradius 10
		backcolor 1 1 1 .4
		visible 1
		decoration
		}

	itemDef {
		name quick
		rect 0 0 270 290
		style WINDOW_STYLE_ROUNDED
		cornerradius 8
		forecolor 1 1 1 1
		backcolor 0 0 0 .88
		visible 1
		decoration
		}

	itemDef {
		name quick
		text "@QUICK_TITLE"
		textfont UI_FONT_NORMAL
		textalign ITEM_ALIGN_CENTER
		textalignx 132
		textaligny 14
		textscale .25
		rect 3 2 264 20
		style WINDOW_STYLE_FILLED
		border			1
		bordercolor		  1 1 1 .3
		forecolor		1 1 1 1
		backcolor		.3 0.5 0.2 .25
		visible			1
		decoration
		}

		itemDef {
			name			iq_playername
			visible			1
			rect			0 30 270 15		
			forecolor		1 1 1 1
			backcolor		  1 1 1 .07
			outlinecolor	1 1 0 .5
			textfont		UI_FONT_NORMAL
			type			ITEM_TYPE_EDITFIELD
			style			WINDOW_STYLE_FILLED
			maxChars		16
			maxpaintchars	16
			text			"@MULTI_NAME_LABEL"
			cvar			"name"
			textscale		.22
			textalign		ITEM_ALIGN_RIGHT
			textalignx		96
			textaligny		11
			cvarTest		"cl_steamActive"
			disableCvar		{ "1" }
			mouseEnter { setitemcolor iq_playername backcolor .3 0.5 0.2 .25 }
			mouseExit { setitemcolor iq_playername backcolor 1 1 1 .07 }
			}
			
		itemDef {
			name iq_brightness
			type ITEM_TYPE_SLIDER
			text "@QUICK_BRIGHTNESS"
			cvarfloat "r_gamma" 1.3 .5 3
			rect 0 65 270 12
			textfont UI_FONT_NORMAL
			textalign ITEM_ALIGN_RIGHT
			textalignx 96
			textaligny 11
			textscale .22
			style WINDOW_STYLE_FILLED
			backcolor   1 1 1 .07
			forecolor 1 1 1 1
			visible 1
			action { uiScript glCustom }
			mouseEnter { setitemcolor iq_brightness backcolor .3 0.5 0.2 .25 }
			mouseExit { setitemcolor iq_brightness backcolor 1 1 1 .07 }
			}

		itemDef {
			name iq_fov
			type ITEM_TYPE_SLIDER
			text "FOV (90-115):"
			cvarfloat "cg_fov" 90 90 115
			rect 0 80 270 12
			textfont UI_FONT_NORMAL
			textalign ITEM_ALIGN_RIGHT
			textalignx 96
			textaligny 11
			textscale .22
			style WINDOW_STYLE_FILLED
			backcolor   1 1 1 .07
			forecolor 1 1 1 1
			visible 1
			action { uiScript glCustom }
			mouseEnter { setitemcolor iq_fov backcolor .3 0.5 0.2 .25 }
			mouseExit { setitemcolor iq_fov backcolor 1 1 1 .07 }
			}

		itemDef {
			name iq_fullscreen
			type ITEM_TYPE_MULTI
			text "@QUICK_FULLSCREEN"
			cvar "r_fullscreen"
			cvarFloatList		{ "@GENERAL_NO" 0 "@GENERAL_YES" 1 }
			rect 0 95 270 12
			textfont UI_FONT_NORMAL
			textalign ITEM_ALIGN_RIGHT
			textalignx 96
			textaligny 11
			textscale .22
			style WINDOW_STYLE_FILLED
			backcolor   1 1 1 .07        
			forecolor 1 1 1 1
			visible 1
			action { uiScript glCustom }
			mouseEnter { setitemcolor iq_fullscreen backcolor .3 0.5 0.2 .25 }
			mouseExit { setitemcolor iq_fullscreen backcolor 1 1 1 .07 }
			}

		itemDef {
			name iq_soundvolume
			type ITEM_TYPE_SLIDER
			text "@QUICK_SOUNDVOLUME"
			cvarfloat "s_volume" 0.7 0 1
			rect 0 115 270 12
			textfont UI_FONT_NORMAL
			textalign ITEM_ALIGN_RIGHT
			textalignx 96
			textaligny 12
			textscale .22
			style WINDOW_STYLE_FILLED
			backcolor   1 1 1 .07
			forecolor 1 1 1 1
			visible 1
			mouseEnter { setitemcolor iq_soundvolume backcolor .3 0.5 0.2 .25 }
			mouseExit { setitemcolor iq_soundvolume backcolor 1 1 1 .07 }
			}
		
		itemDef {
			name iq_musicvolume
			type ITEM_TYPE_SLIDER
