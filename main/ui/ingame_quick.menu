#include "ui/menudef.h"
{

\\ INGAME_QUICK MENU \\

menuDef {
	name "ingame_quick"
	visible 0
	fullScreen 0
	outOfBoundsClick			// this closes the window if it gets a click out of the rectangle
	rect 328 110 220 290
	focusColor 1 .75 0 1
	disableColor .5 .5 .5 1



	itemDef {
		name quick
		rect 0 0 220 290	
		style WINDOW_STYLE_FILLED
		border 1
		bordercolor .5 .5 .5 .5
		forecolor 1 1 1 1
		backcolor 0 0 0 .5
		visible 1
		decoration
		}	

	itemDef {
		name quick
		text "@QUICK_TITLE"
		textfont UI_FONT_NORMAL
		textalign ITEM_ALIGN_CENTER
		textalignx 107
		textaligny 14
		textscale .25
		rect 3 2 214 20
		style WINDOW_STYLE_FILLED
		border			1
		bordercolor		.5 .5 .5 .5
		forecolor		1 1 1 1
		backcolor		.3 0.5 0.2 .25
		visible			1
		decoration
		}

		itemDef {
			name			quick
			visible			1
			rect			-30 30 220 15		
			forecolor		1 1 1 1
			backcolor		0 0 0 0
			outlinecolor	1 1 0 .5
			textfont		UI_FONT_NORMAL
			type			ITEM_TYPE_EDITFIELD
			style			0
			maxChars		16
			maxpaintchars	16
			text			"@MULTI_NAME_LABEL"
			cvar			"name"
			textscale		.22
			textalign		ITEM_ALIGN_RIGHT
			textalignx		126
			textaligny		11
			cvarTest		"cl_steamActive"
			disableCvar		{ "1" }
			}
			
		itemDef {
			name			quick
			visible			1
			rect			-30 45 220 15		
