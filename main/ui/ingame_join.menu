#include "ui/menudef.h"


{

\\ SETUP MENU \\

menuDef {

		name "ingame_join"
		visible 0
		fullscreen 0
		outOfBoundsClick			// this closes the window if it gets a click out of the rectangle
		rect 20 115 605 335
		focusColor 1 .75 0 1
		disableColor .5 .5 .5 1
		style 1
		border 1

		onOpen {
				//setCvar cg_draw2D "0";
				show grpJoin ; }
		onClose { setCvar cg_draw2D "1" }
		onEsc { setCvar cg_draw2D "1" }

//////// START OF PASTE

	// Start of Join Server Border

	itemDef 
		{
		name window
		group grpJoin
		rect 0 0 600 300	
		style WINDOW_STYLE_FILLED
		border 1
		bordercolor .5 .5 .5 .5
		forecolor 1 1 1 1
		backcolor 0 0 0 .5
		visible 1
		decoration
		}

	// End of Join Server Border	
	
	//  1ST COLUMN  //
	
	
		itemDef {
			name			refreshSource
			group			grpJoin
			text			"@MULTI_GETNEWLIST"
			type			ITEM_TYPE_BUTTON
			textscale		.28
			style			WINDOW_STYLE_FILLED	
			//background	"ui_mp/assets/button_red.tga"
			border			1
			bordercolor		.5 .5 .5 .5
			rect			10 21 105 20
			textalign		1
			textalignx		52		// center
			textaligny		14
			textfont		UI_FONT_NORMAL
			backcolor		.3 .5 .2 .3
			forecolor		1 1 1 1
			visible			1 
			
			mouseEnter		{ show message_refreshSOurce ; setitemcolor refreshSource backcolor .1 .2 .37 1 }
			mouseExit		{ hide message_refreshSource ; setitemcolor refreshSource backcolor .3 .5 .2 .3 }
			action			{ play "sound/misc/nomenu.wav" ; 
							uiScript RefreshServers ;
							uiScript RefreshFilter }								
			}


		itemDef {
			name			refreshFilter
			group			grpJoin
			text			"@MULTI_REFRESHLIST"
			textscale		.28
			style			WINDOW_STYLE_FILLED
			textfont		UI_FONT_NORMAL
			type			ITEM_TYPE_BUTTON
			border			1
			bordercolor		.5 .5 .5 .5
			rect			10 46 105 20
			textalign		1
			textalignx		52		// center
			textaligny		14
			backcolor		.3 .5 .2 .3 
			forecolor		1 1 1 1
			visible			1 
			mouseEnter		{ show message_refreshFilter ; setitemcolor refreshFilter backcolor .1 .2 .37 1 }
			mouseExit		{ hide message_refreshFilter ; setitemcolor refreshFilter backcolor .3 .5 .2 .3 }	  	  
			action			{ play "sound/misc/nomenu.wav" ; 
							uiScript RefreshFilter }	  	  
			}


		itemDef {
			name			serverinfo
			text			"@MULTI_SERVERINFO"
			group			grpJoin
			type			ITEM_TYPE_BUTTON
			textfont		UI_FONT_NORMAL
			textscale		.28
			style			WINDOW_STYLE_FILLED
			border			1
			bordercolor		.5 .5 .5 .5
			rect			10 71 105 20
			textalign		1
			textalignx		52		// center
			textaligny		14
			backcolor		.3 .5 .2 .3
			forecolor		1 1 1 1
			visible			1

			action {
				play		"sound/misc/kcaction.wav" ; 
				setcvar		ui_serverBrowser 1 ; // 1: from server browser
				open		ingame_serverinfo_popmenu
			}

			mouseEnter		{ show message_serverinfo ; setitemcolor serverinfo backcolor .1 .2 .37 1 }
			mouseExit		{ hide message_serverinfo ; setitemcolor serverinfo backcolor .3 .5 .2 .3 }	 
				}


// Start of BACK and CONNECT Button


		itemDef {
			name gotobar
			style 2
			rect -20 310 640 20 
			textscale 0.4
			textalign 0		// center
			textalignx 60        	// x alignment point for text
			// use it to offset left/right text from the edge 
			// or to center the text on a different point
			textaligny 21        
			style 2
			border 4
			bordercolor 0.5 0.5 0.5 0.0
			bordersize 2
			backcolor 0.5 0.5 .5 0.0
			visible 1 
			mouseEnter { setcolor backcolor .5 0.5 0.5 .5 }
			mouseExit { setcolor backcolor .5 .5 .5 .0 }
			decoration 
			}

		itemDef {
			name back
			text "@GENERAL_BACK"
			type 1
			style 0	
			textstyle 6
			rect 10 315 90 14 
			textalign 0
			textfont UI_FONT_NORMAL
			textscale .255		
			textalignx 6
			textaligny 12
			forecolor .9 .9 .9 .9
			visible 1
			action {
			close ingame_join ;
			open ingame }

			mouseEnter { 
			hide back ;
			show back_alt ;
			show message_back
			}
			}

		itemDef {
			name back_alt
			text "@GENERAL_BACK"
			type 1
			style 0	
			textstyle 6
			rect 10 315 90 14 
			textalign 0
			textfont UI_FONT_NORMAL
			textscale .255	
			textalignx 6
			textaligny 12
			forecolor .6 .6 .6 .6
			visible 1 
			type ITEM_TYPE_BUTTON
			action {
			close ingame_join ;
			open ingame }
	  
			mouseExit {
			hide back_alt ;
			show back ;
			hide message_back }	  
			}


		itemDef {
			name connect
			text "@MULTI_CONNECT"
			group grpJoin
			type 1
			textfont	UI_FONT_NORMAL
			style 0	
			textstyle 6
			rect 525 315 70 14 
			textalign 0
			textscale .25		
			textalignx 5
			textaligny 12
			forecolor .9 .9 .9 .9
			visible 1
			//border 1
			//bordercolor 1 1 1 1
			
			
			mouseEnter {
			hide connect ;
			show connect_alt
			show message_connect
			}

			action {
			close multi_menu ;
			uiScript JoinServer
			}	
			}

		itemDef {
			name connect_alt
			text "@MULTI_CONNECT"
			group grpJoin
			type 1
			style 0	
			textstyle 6
			rect 525 315 70 14 
			textalign 0
			textfont	UI_FONT_NORMAL
			textscale .25		
			textalignx 5
			textaligny 12
			forecolor .6 .6 .6 .6
			visible 1 
			type ITEM_TYPE_BUTTON
			//border 1
			//bordercolor 1 1 1 1

			mouseExit {
				hide connect_alt ;
				show connect	;
				hide message_connect
			}

			action {
				uiScript JoinServer
			}  	  
		}

// End of BACK and CONNECT Buttons

	//  2ND COLUMN  //

		itemDef {
			name			window_limbo_name
			group			grpJoin
			visible			1
			rect			140 18 130 15
			textstyle		6			
			forecolor		1 1 1 1
			outlinecolor	1 1 0 .5
			textfont		UI_FONT_NORMAL
			type			ITEM_TYPE_EDITFIELD
			style			0
			maxChars		16
			maxpaintchars	16
			text			"@MULTI_NAME_LABEL"
			cvar			"name"
			textscale		.25
			textalign		ITEM_ALIGN_LEFT
			textalignx		0
			textaligny		14
			cvarTest		"cl_steamActive"
			disableCvar		{ "1" }
			}

      itemDef {
			name			download
			group			grpJoin
			visible			1
			rect			140 38 130 15		
			forecolor		1 1 1 1
			backcolor		0 0 0 0
			outlinecolor	1 1 0 .5
			textfont		UI_FONT_NORMAL
			type			ITEM_TYPE_MULTI
			style			0
			textstyle		6
			maxChars		16
			maxpaintchars	16
			text			"@MULTI_DOWNLOADS_LABEL"
			cvar			"cl_allowDownload"
			cvarFloatList	{ "@GENERAL_NO" 0 "@GENERAL_YES" 1 }
			textscale		.25
			textalign		ITEM_ALIGN_LEFT	
			textalignx		0
			textaligny		14
			}
	
			itemDef {
			name			passwordEntry
			group			grpJoin
			visible			1
			rect			140 58 270 15
			textstyle		6			
			forecolor		1 1 1 1
			outlinecolor	1 1 0 .5
			textfont		UI_FONT_NORMAL
			type			ITEM_TYPE_EDITFIELD
			style			0
			maxChars		32
			maxpaintchars	32
			text			"@MULTI_PASSWORD_LABEL"
			cvar			"password"
			textscale		.25
			textalign		ITEM_ALIGN_LEFT	
			textalignx		0
			textaligny		14
			}

		itemDef {
			name			gametypefield
			group			grpJoin
			style			0	
			textfont		UI_FONT_NORMAL
			ownerdraw		UI_NETSOURCE
			rect			140 78 130 15 
			textstyle		6
			textalign		ITEM_ALIGN_LEFT		
			textalignx		0     
			textaligny		14
			textscale		.25   
			forecolor		1 1 1 1
			visible 		1
			
			action			{ play "sound/misc/kcaction.wav" }
			}




