		rect 0 48 600 22
		type ITEM_TYPE_MULTI
		style WINDOW_STYLE_FILLED
		text "@OPTIONS_SUBTITLES"
		textfont UI_FONT_BIG	// RealRTCWCoop
		cvar "cg_drawSubtitles"
		cvarFloatList	{ "@GENERAL_OFF" 0 "@GENERAL_ON" 1}
		textscale .32
		textalign ITEM_ALIGN_RIGHT
		textalignx 280
		textaligny 16
		backcolor 1 1 1 .07
		forecolor 1 1 1 1
		visible 1
		mouseEnter { setitemcolor snd_subtitles backcolor .3 0.5 0.2 .25 ; show tip_subtitles ; show tipbox }
		mouseExit { setitemcolor snd_subtitles backcolor 1 1 1 .07 ; hide tip_subtitles ; hide tipbox }
		}

