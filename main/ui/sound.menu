#include "ui/menudef.h"

{
\\ SOUND TAB \\

menuDef {
	name "sound_menu"
	visible 0
	fullscreen 0
	rect 20 130 600 326
	focusColor 1 .75 0 1
	style 1
	border 1
	onOpen { setitemcolor fadebox backcolor 0 0 0 1 ; fadeout fadebox ; show grpSound ; hide tipbox }
	onEsc { close sound_menu ; close setup_menu ; open main }

	itemDef {
		name snd_effectsvolume
		group grpSound
		type ITEM_TYPE_SLIDER
		text "@SYSTEM_EFFECTSVOLUME_LABEL"
		textfont UI_FONT_BIG	// RealRTCWCoop
		cvarfloat "s_volume" 0.7 0 1
		rect 0 0 600 22
		textalign ITEM_ALIGN_RIGHT
		textalignx 280
		textaligny 16
		textscale .32
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
		forecolor 1 1 1 1
		visible 1
		mouseEnter { setitemcolor snd_effectsvolume backcolor .3 0.5 0.2 .25 ; show tip_effectsvolume ; show tipbox }
		mouseExit { setitemcolor snd_effectsvolume backcolor 1 1 1 .07 ; hide tip_effectsvolume ; hide tipbox }
    		}

	itemDef {
		name snd_musicvolume
		group grpSound
		type ITEM_TYPE_SLIDER
		text "@SYSTEM_MUSICVOLUME_LABEL"
		textfont UI_FONT_BIG	// RealRTCWCoop
		cvarfloat "s_musicvolume" 0.25 0 1
		rect 0 24 600 22
		textalign ITEM_ALIGN_RIGHT
		textalignx 280
		textaligny 16
		textscale .32
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
		forecolor 1 1 1 1
		visible 1
		mouseEnter { setitemcolor snd_musicvolume backcolor .3 0.5 0.2 .25 ; show tip_musicvolume ; show tipbox }
		mouseExit { setitemcolor snd_musicvolume backcolor 1 1 1 .07 ; hide tip_musicvolume ; hide tipbox }
    		}

	itemDef {
		name snd_subtitles
