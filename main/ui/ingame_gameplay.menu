#include "ui/menudef.h"

{
\\ INGAME GAMEPLAY TAB (HUD Settings / Hit Feedback / Crosshair Settings - drill-down list, mirrors main menu gameplay.menu) \\

menuDef {
		name "ingame_gameplay"
		visible 0
		fullscreen 0
		rect 220 110 443 366
		focusColor 1 .75 0 1
		style 1
		border 1
		onopen { hide performance ; hide hitfeedback ; hide crosshair ; show ctr_hud ; show ctr_hitfeedback ; show ctr_crosshair ; hide tipbox ; hide grpIngameGameplayTip }

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////                        NAV ROWS                         //////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	itemDef {
		name ctr_hud
		group grpIngameGameplayNav
		text "@OPTIONS_HUDSETTINGS"
		textfont UI_FONT_BIG
		type ITEM_TYPE_BUTTON
		textalign ITEM_ALIGN_CENTER
		textalignx 221
		textaligny 14
		textscale .24
		rect 0 0 443 20
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
		forecolor 1 1 1 1
		visible 1
		action { play "sound/misc/kcaction.wav" ; hide ctr_hud ; hide ctr_hitfeedback ; hide ctr_crosshair ; hide tipbox ; hide grpIngameGameplayTip ; show performance }
		mouseEnter { setitemcolor ctr_hud backcolor .3 0.5 0.2 .25 ; show tip_ctr_hud ; show tipbox }
		mouseExit { setitemcolor ctr_hud backcolor 1 1 1 .07 ; hide tip_ctr_hud ; hide tipbox }
	}

	itemDef {
		name ctr_hitfeedback
		group grpIngameGameplayNav
		text "@OPTIONS_HITFEEDBACK"
		textfont UI_FONT_BIG
		type ITEM_TYPE_BUTTON
		textalign ITEM_ALIGN_CENTER
		textalignx 221
		textaligny 14
		textscale .24
		rect 0 22 443 20
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
		forecolor 1 1 1 1
		visible 1
		action { play "sound/misc/kcaction.wav" ; hide ctr_hud ; hide ctr_hitfeedback ; hide ctr_crosshair ; hide tipbox ; hide grpIngameGameplayTip ; show hitfeedback }
		mouseEnter { setitemcolor ctr_hitfeedback backcolor .3 0.5 0.2 .25 ; show tip_ctr_hitfeedback ; show tipbox }
		mouseExit { setitemcolor ctr_hitfeedback backcolor 1 1 1 .07 ; hide tip_ctr_hitfeedback ; hide tipbox }
	}

	itemDef {
		name ctr_crosshair
		group grpIngameGameplayNav
		text "@OPTIONS_CROSSHAIRSETTINGS"
		textfont UI_FONT_BIG
		type ITEM_TYPE_BUTTON
		textalign ITEM_ALIGN_CENTER
		textalignx 221
		textaligny 14
		textscale .24
		rect 0 44 443 20
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
		forecolor 1 1 1 1
		visible 1
		action { play "sound/misc/kcaction.wav" ; hide ctr_hud ; hide ctr_hitfeedback ; hide ctr_crosshair ; hide tipbox ; hide grpIngameGameplayTip ; show crosshair }
		mouseEnter { setitemcolor ctr_crosshair backcolor .3 0.5 0.2 .25 ; show tip_ctr_crosshair ; show tipbox }
		mouseExit { setitemcolor ctr_crosshair backcolor 1 1 1 .07 ; hide tip_ctr_crosshair ; hide tipbox }
	}

