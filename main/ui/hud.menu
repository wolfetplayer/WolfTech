	//	STABILITY	//

	menuDef {
    	name "stability"
    	fullScreen MENU_FALSE
    	visible MENU_TRUE
    	rect -80 206 10 64	// bar anchored in center, fills up/down

		itemDef {
			name "stabRect"
			decoration
			visible MENU_TRUE

			addColorRange	0 128	.24 .4 .14 1
