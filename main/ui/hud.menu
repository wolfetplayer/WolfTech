#include "ui/menudef.h"

{
	assetGlobalDef {
	
		#include "ui/fonts.menu"
		
		// hints
		breakableHint		"gfx/2d/breakableHint.tga"
		clipboardHint		"gfx/2d/clipboardHint.tga"
		doorHint			"gfx/2d/doorHint.tga"
		doorLockHint		"gfx/2d/lockedHint.tga"
		doorRotateHint		"gfx/2d/doorHint.tga"
		doorRotateLockHint	"gfx/2d/lockedHint.tga"
		exitHint			"gfx/2d/exitHint.tga"
		knifeHint			"gfx/2d/knifeHint.tga"
		ladderHint			"gfx/2d/ladderHint.tga"
		//friendHint		"gfx/2d/speechHint.tga"
		speakHint			"gfx/2d/speechHint.tga"
		mg42Hint			"gfx/2d/mg42Hint.tga"
		waterHint			"gfx/2d/vanilla/waterHint.tga"
		
		cautionHint			"gfx/2d/et/tankHint.tga"		// Tank
		dangerHint			"gfx/2d/dynamiteHint.tga"		// Dynamite
		exclamationHint		"gfx/2d/et/satchelHint.tga"		// Satchel
		hintPlrFriend		"gfx/2d/et/landmineHint.tga"	// Landmine
		hintPlrNeutral		"gfx/2d/et/buildHint.tga"		// Build (Disarm)
		hintPlrEnemy		"gfx/2d/et/uniformHint.tga"		// Uniform
		hintPlrUnknown		"gfx/2d/et/reviveHint.tga"		// Revive / Speech (RealRTCW)
						//	"gfx/2d/speechHint.tga"
		
		notUsableHint		"gfx/2d/notUsableHint.tga"
		usableHint			"gfx/2d/usableHint.tga"
		
		alarmHint			"gfx/2d/usableHint.tga"
		ammoHint			"gfx/2d/usableHint.tga"
		armorHint			"gfx/2d/usableHint.tga"
		buttonHint			"gfx/2d/usableHint.tga"
		chairHint			"gfx/2d/usableHint.tga"
		healthHint			"gfx/2d/usableHint.tga"
		holdableHint		"gfx/2d/usableHint.tga"
		inventoryHint		"gfx/2d/usableHint.tga"
		powerupHint			"gfx/2d/usableHint.tga"
		treasureHint		"gfx/2d/usableHint.tga"
		weaponHint			"gfx/2d/usableHint.tga"
		
		youGotMail			"gfx/2d/youGotMail.tga"
		youGotObjective		"gfx/2d/youGotObjective.tga"
		
		friendlyCross		"gfx/2d/friendlyCross.tga"

		cursor "ui/assets/3_cursor3"				// cursor	
		gradientBar "ui/assets/gradientbar2.tga"	// gradient bar

		fadeClamp 1.0								// sets the fadeup alpha
		fadeCycle 1									// how often fade happens in milliseconds
		fadeAmount 0.1								// amount to adjust alpha per cycle

		shadowX  5									// x amount for shadow offset
		shadowY  5									// y amount for shadow offset
		shadowColor 0.1 0.1 0.1 0.25				// shadow color
	}
	
// SURVIVAL //

	menuDef
	{
    	name "Survival"
    	fullScreen MENU_FALSE
    	visible MENU_TRUE
		style WINDOW_STYLE_EMPTY
    	rect 60 0 640 480
		
		itemDef
		{
 			name "waves"

			cvarTest "g_gameType"
			showCvar { "0" }

			ownerDraw CG_PLAYER_WAVES
			
			rect -52 4 32 32
			
			decoration
			foreColor 1 0 0 1
			textFont UI_FONT_NORMAL
			textAlignX 7
			textScale .48
			textStyle ITEM_TEXTSTYLE_SHADOWED
			visible MENU_TRUE
			
			addColorRangerel 0 1	1.0 1.0 1.0 1
			addColorRangerel 1 2	1.0 0.9 0.9 1
			addColorRangerel 2 3	1.0 0.8 0.8 1
			addColorRangerel 3 4	1.0 0.7 0.7 1
			addColorRangerel 4 5	1.0 0.6 0.6 1
			addColorRangerel 5 6	1.0 0.5 0.5 1
			addColorRangerel 6 7	1.0 0.4 0.4 1
			addColorRangerel 7 8	1.0 0.3 0.3 1
			addColorRangerel 8 9	1.0 0.2 0.2 1
			addColorRangerel 9 10	1.0 0.1 0.1 1
			addColorRangerel 10 999	1.0 0.0 0.0 1
		}
	}
	

//	PLAYER STATUS	//

	menuDef {
    	name "Status"
    	fullScreen MENU_FALSE
    	visible MENU_TRUE
    	rect 40 438 372 32

		//	NOTEBOOK
		
		itemDef {
			name "chRect"
			
			cvarTest "g_gameType"
			hideCvar { "2" }
			
			decoration
			visible MENU_TRUE
			rect 11 -395 217 48
			ownerdraw CG_NEWMESSAGE
		}

		
		//	HEAT INDICATOR	

		// heat indicator	
		itemDef {
			name "heat"
			
			cvarTest "g_gameType"
			hideCvar { "2" }
			
			decoration
			visible MENU_TRUE
			rect 456 -44 83 43		// horizontal version
			align HUD_HORIZONTAL
			ownerdraw CG_PLAYER_WEAPON_HEAT
		}
		
		itemDef {
			name "heat"
			
			cvarTest "g_gameType"
			showCvar { "2" }
			
			decoration
			visible MENU_TRUE
			rect 456 -66 83 43		// horizontal version
			align HUD_HORIZONTAL
			ownerdraw CG_PLAYER_WEAPON_HEAT
		}


		//	WEAPON ICON

		// ammo icon
		itemDef {
			name "a"
			rect 458 -40 80 40

			visible MENU_TRUE
			decoration
			align ITEM_ALIGN_CENTER
			ownerdraw CG_PLAYER_WEAPON_ICON2D
		}

		
		//	CLIP
		
		itemDef {
			name ""
			rect 443 0 55 22
			decoration
			visible MENU_TRUE
			style WINDOW_STYLE_SHADER
			background "gfx/2d/back_box.tga"
			
			ownerdraw CG_PLAYER_AMMOCLIP_VALUE
			ownerdrawflag CG_SHOW_NOT_V_BINOC
			
			addColorRangerel	0 999		1 1 1 1
			
			forecolor 1 1 1 0
		}
	
		// clip icon
		itemDef {
			name ""
			rect 448 5 12 12
			
			cvarTest "cg_hudAmmoClip"
			showCvar { "1" }
			
			decoration
			visible MENU_TRUE
			style WINDOW_STYLE_SHADER
			background "gfx/hud/et/ic_clip.tga"
			
			ownerdraw CG_PLAYER_AMMOCLIP_VALUE
			ownerdrawflag CG_SHOW_NOT_V_BINOC
			
			addColorRangerel	0 999		1 1 1 1
			
			forecolor 1 1 1 0
		}
		
		// clip count value
		itemDef {
 			name "cliptex"
			rect 456 -5.5 55 22
			visible MENU_TRUE
			decoration
			
			cvarTest "cg_hudAmmoClip"
			showCvar { "0" }

			textfont UI_FONT_NORMAL
			textscale .18		// shrunk from .32 - 3-digit clip counts were overflowing back_box.tga

			ownerdraw CG_PLAYER_AMMOCLIP_VALUE
			ownerdrawflag CG_SHOW_NOT_V_BINOC

			addColorRangerel 0.0	0.1		1 0 0 1		// alert!
			addColorRangerel 0.1	0.33	1 1 0 1		// warning!

			forecolor 1 1 1 1
		}

		// clip count value
		itemDef {
 			name "cliptex"
			rect 469 -5.5 38 22
			visible MENU_TRUE
			decoration

			cvarTest "cg_hudAmmoClip"
			showCvar { "1" }

			textfont UI_FONT_NORMAL
			textscale .18		// shrunk from .32 - 3-digit clip counts were overflowing back_box.tga
			
			ownerdraw CG_PLAYER_AMMOCLIP_VALUE
			ownerdrawflag CG_SHOW_NOT_V_BINOC
			
			addColorRangerel 0.0	0.1		1 0 0 1		// alert!
			addColorRangerel 0.1	0.33	1 1 0 1		// warning!
			
			forecolor 1 1 1 1
		}

		
//	AMMO
		itemDef {
			name ""
			rect 498 0 55 22
			decoration
			visible MENU_TRUE
			style WINDOW_STYLE_SHADER
			background "gfx/2d/back_box.tga"
			
			ownerdraw CG_PLAYER_AMMO_VALUE
			ownerdrawflag CG_SHOW_NOT_V_BINOC
			
			addColorRangerel	0 999		1 1 1 1
			
			forecolor 1 1 1 0
		}
	
		// ammo icon
		itemDef {
			name ""
			rect 503 5 12 12
			
			cvarTest "cg_hudAmmoClip"
			showCvar { "1" }
			
			decoration
			visible MENU_TRUE
			style WINDOW_STYLE_SHADER
			background "gfx/hud/et/ic_ammo.tga"
			
			ownerdraw CG_PLAYER_AMMO_VALUE
			ownerdrawflag CG_SHOW_NOT_V_BINOC
			
			addColorRangerel	0 999		1 1 1 1
			
			forecolor 1 1 1 0
		}
		
		// ammo value
		itemDef {
 			name "amtex"
			rect 511 9.5 55 22
			visible MENU_TRUE
			decoration
			
			cvarTest "cg_hudAmmoClip"
			showCvar { "0" }

			textfont UI_FONT_NORMAL
			textscale .18		// shrunk from .32 - 3-digit reserve ammo counts were overflowing back_box.tga

			ownerdraw CG_PLAYER_AMMO_VALUE
			ownerdrawflag CG_SHOW_NOT_V_BINOC

			addColorRangerel 0.0	0.1		1 0 0 1		// alert!
			addColorRangerel 0.1	0.33	1 1 0 1		// warning!

			forecolor 1 1 1 1
		}

		// ammo value
		itemDef {
 			name "amtex"
			rect 516 9.5 55 22
			visible MENU_TRUE
			decoration

			cvarTest "cg_hudAmmoClip"
			showCvar { "1" }

			textfont UI_FONT_NORMAL
			textscale .18		// shrunk from .32 - 3-digit reserve ammo counts were overflowing back_box.tga
			
			ownerdraw CG_PLAYER_AMMO_VALUE
			ownerdrawflag CG_SHOW_NOT_V_BINOC
			
			addColorRangerel 0.0	0.1		1 0 0 1		// alert!
			addColorRangerel 0.1	0.33	1 1 0 1		// warning!
			
			forecolor 1 1 1 1
		}

	}

	//	GRENADE COUNT	//	always visible, height-aligned to the weapon ammo count
	menuDef {
    	name "GrenadeCount"
    	fullScreen MENU_FALSE
    	visible MENU_TRUE
    	rect 452 435 54 28

		itemDef {
			name "grencount"
			ownerdraw CG_PLAYER_GRENADE_COUNT
			rect -50 0 54 28
			visible MENU_TRUE
			decoration
			textstyle ITEM_TEXTSTYLE_SHADOWEDMORE
			textscale .42
			forecolor .63 .59 .57 1	// grey
		}
}

