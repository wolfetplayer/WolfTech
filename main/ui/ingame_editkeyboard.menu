#include "ui/menudef.h"

{
\\ INGAME EDIT KEYBOARD (full bind list, 2 columns, category dividers) \\

menuDef {
	name "ingame_editkeyboard"
	visible 0
	fullscreen 0
	outOfBoundsClick
	rect 220 30 443 445
	focusColor 1 .75 0 1
	style 1
	border 1
	onClose { uiScript saveControls }
	onOpen { show grpIngameKeybinds }
	onEsc { close ingame_editkeyboard ; open ingame_options ; close ingame_gameplay ; open ingame_controls }

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////                        PANEL                            //////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	itemDef
	{
		name panelborder
		rect -2 0 447 445
		style WINDOW_STYLE_ROUNDED
		cornerradius 10
		backcolor 1 1 1 .4
		visible 1
		decoration
	}

	itemDef
	{
		name window
		rect 0 2 443 441
		style WINDOW_STYLE_ROUNDED
		cornerradius 8
		forecolor 1 1 1 1
		backcolor 0 0 0 .88
		visible 1
		decoration
	}

