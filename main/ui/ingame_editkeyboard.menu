////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////                        STATUS STRIP / BACK              //////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	itemDef {
		name ikeyBindStatus
		rect 10 398 423 16
		ownerdraw UI_KEYBINDSTATUS
		text " "
		textfont UI_FONT_BIG
		forecolor 1 .75 0 1
		textscale .18
		textalignx 211
		textalign 1
		textaligny 12
		visible 0
		decoration
	}

	itemDef {
		name ingame_backkeys
		text "@MAIN_BACK"
		type ITEM_TYPE_BUTTON
		rect 146 418 150 20
		textfont UI_FONT_BIG
		textalign ITEM_ALIGN_CENTER
		textalignx 75
		textaligny 14
		textscale .22
		style WINDOW_STYLE_FILLED
		border 1
		bordercolor .5 .5 .5 .5
		forecolor 1 1 1 1
		backcolor .05 .05 .05 .65
		visible 1
		action { close ingame_editkeyboard ; open ingame_options ; close ingame_gameplay ; open ingame_controls }
		mouseEnter { setitemcolor ingame_backkeys backcolor .3 0.5 0.2 .5 }
		mouseExit { setitemcolor ingame_backkeys backcolor .05 .05 .05 .65 }
	}

}

}
