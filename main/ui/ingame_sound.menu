#include "ui/menudef.h"

{
\\ INGAME SOUND TAB (moved out of ingame_system) \\

menuDef {
	name "ingame_sound"
	visible 0
	fullscreen 0
	rect 220 110 443 366
	focusColor 1 .75 0 1
	style 1
	border 1

	itemDef {
		name isnd_effectsvolume
		type ITEM_TYPE_SLIDER
		text "@SYSTEM_EFFECTSVOLUME_LABEL"
		textfont		UI_FONT_BIG
		cvarfloat "s_volume" 0.7 0 1
		rect 0 0 443 16
		textalign ITEM_ALIGN_RIGHT
		textalignx 224
		textaligny 12
		textscale .22
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
		forecolor 1 1 1 1
		visible 1
		mouseEnter { setitemcolor isnd_effectsvolume backcolor .3 0.5 0.2 .25 ; show tip_isnd_effectsvolume ; show tipbox }
		mouseExit { setitemcolor isnd_effectsvolume backcolor 1 1 1 .07 ; hide tip_isnd_effectsvolume ; hide tipbox }
		}

	itemDef {
		name isnd_musicvolume
		type ITEM_TYPE_SLIDER
