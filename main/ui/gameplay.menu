#include "ui/menudef.h"

{
\\ GAMEPLAY TAB (formerly options_menu) \\

menuDef {
	name "gameplay_menu"
	visible 0
	fullscreen 0
	rect 20 130 600 326
	focusColor 1 .75 0 1
	style 1
	border 1
	onOpen { setitemcolor fadebox backcolor 0 0 0 1 ; fadeout fadebox ; hide performance ; hide hitfeedback ; hide crosshair ; show ctr_hud ; show ctr_hitfeedback ; show ctr_crosshair ; hide tipbox ; hide grpGameplayTip }
	onEsc { close gameplay_menu ; close setup_menu ; open main }

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////                        NAV ROWS                         //////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	itemDef {
		name ctr_hud
		group grpOptionsTab
		text "@OPTIONS_HUDSETTINGS"
		textfont UI_FONT_BIG	// RealRTCWCoop
		type ITEM_TYPE_BUTTON
		textalign ITEM_ALIGN_CENTER
		textalignx 290
		textaligny 16
		textscale .32
		rect 0 0 600 22
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
		forecolor 1 1 1 1
		visible 1
		action { play "sound/misc/kcaction.wav" ; hide ctr_hud ; hide ctr_hitfeedback ; hide ctr_crosshair ; hide tipbox ; hide grpGameplayTip ; show performance }
		mouseEnter { setitemcolor ctr_hud backcolor .3 0.5 0.2 .25 ; show tip_ctr_hud ; show tipbox }
		mouseExit { setitemcolor ctr_hud backcolor 1 1 1 .07 ; hide tip_ctr_hud ; hide tipbox }
	}

	itemDef {
		name ctr_hitfeedback
		group grpOptionsTab
		text "@OPTIONS_HITFEEDBACK"
		textfont UI_FONT_BIG	// RealRTCWCoop
		type ITEM_TYPE_BUTTON
		textalign ITEM_ALIGN_CENTER
		textalignx 290
		textaligny 16
		textscale .32
		rect 0 24 600 22
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
		forecolor 1 1 1 1
		visible 1
		action { play "sound/misc/kcaction.wav" ; hide ctr_hud ; hide ctr_hitfeedback ; hide ctr_crosshair ; hide tipbox ; hide grpGameplayTip ; show hitfeedback }
		mouseEnter { setitemcolor ctr_hitfeedback backcolor .3 0.5 0.2 .25 ; show tip_ctr_hitfeedback ; show tipbox }
		mouseExit { setitemcolor ctr_hitfeedback backcolor 1 1 1 .07 ; hide tip_ctr_hitfeedback ; hide tipbox }
	}

	itemDef {
		name ctr_crosshair
		group grpOptionsTab
		text "@OPTIONS_CROSSHAIRSETTINGS"
		textfont UI_FONT_BIG	// RealRTCWCoop
		type ITEM_TYPE_BUTTON
		textalign ITEM_ALIGN_CENTER
		textalignx 290
		textaligny 16
		textscale .32
		rect 0 48 600 22
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
		forecolor 1 1 1 1
		visible 1
		action { play "sound/misc/kcaction.wav" ; hide ctr_hud ; hide ctr_hitfeedback ; hide ctr_crosshair ; hide tipbox ; hide grpGameplayTip ; show crosshair }
		mouseEnter { setitemcolor ctr_crosshair backcolor .3 0.5 0.2 .25 ; show tip_ctr_crosshair ; show tipbox }
		mouseExit { setitemcolor ctr_crosshair backcolor 1 1 1 .07 ; hide tip_ctr_crosshair ; hide tipbox }
	}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////                        HUD SETTINGS                     //////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	itemDef {
		name hud_alpha
		group performance
		type ITEM_TYPE_SLIDER
		text "@OPTIONS_HUDALPHA"
		textfont UI_FONT_BIG	// RealRTCWCoop
		cvarfloat "cg_hudAlpha" .6 0 1
		rect 0 0 600 22
      	textalign ITEM_ALIGN_RIGHT
      	textalignx 280
      	textaligny 16
		textscale .32
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
      	forecolor 1 1 1 1
      	visible 0
		mouseEnter { setitemcolor hud_alpha backcolor .3 0.5 0.2 .25 ; show tip_hud_alpha ; show tipbox }
		mouseExit { setitemcolor hud_alpha backcolor 1 1 1 .07 ; hide tip_hud_alpha ; hide tipbox }
   	}

	itemDef {
		name hud_cursorhints
		type ITEM_TYPE_MULTI
		group performance
		text "@OPTIONS_CURSORHINTS"
		textfont UI_FONT_BIG	// RealRTCWCoop
		cvar "cg_cursorHints"
		cvarFloatList { "@OPTIONS_CURSORHINTS_STROBE" 2 "@OPTIONS_CURSORHINTS_ALPHA" 3 "@OPTIONS_CURSORHINTS_SOLID" 4 "@OPTIONS_CURSORHINTS_OFF" 0 "@OPTIONS_CURSORHINTS_SIZE" 1 }
		rect 0 24 600 22
		textalign ITEM_ALIGN_RIGHT
		textalignx 280
		textaligny 16
		textscale .32
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
		forecolor 1 1 1 1
		visible 0
		mouseEnter { setitemcolor hud_cursorhints backcolor .3 0.5 0.2 .25 ; show tip_hud_cursorhints ; show tipbox }
		mouseExit { setitemcolor hud_cursorhints backcolor 1 1 1 .07 ; hide tip_hud_cursorhints ; hide tipbox }
	}

