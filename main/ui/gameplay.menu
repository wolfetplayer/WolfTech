			mouseEnter { setitemcolor hud_bloodhit backcolor .3 0.5 0.2 .25 ; show tip_hud_bloodhit ; show tipbox }
			mouseExit { setitemcolor hud_bloodhit backcolor 1 1 1 .07 ; hide tip_hud_bloodhit ; hide tipbox }
    }

