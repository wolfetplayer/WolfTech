#include "ui/menudef.h"

{
\\ SETUP MENU SHELL (horizontal tab bar) \\

menuDef {
   	name "setup_menu"
   	visible 0
   	fullscreen 1
   	rect 0 0 640 480
   	focusColor 1 .75 0 1 // gold pulse, matches the hover/focus treatment used throughout the rest of the options menus
   	style 1
   	border 1
	soundloop ""
	onOpen {
		setitemcolor fadebox backcolor 0 0 0 1 ;
		fadeout fadebox
		}
	onEsc { close gameplay_menu ; close control_menu ; close system_menu ; close sound_menu ; close setup_menu ; open main }

	itemDef {
		name solid_box
		style 1
		rect 4 2 178 426
		border 1
		bordersize 1
		bordercolor .5 .5 .5 .5
		backcolor 0 0 .75 .25
		visible 0
		decoration
	}

// Start of Menu Background

itemDef
	{
		name realrtcw_background
		style WINDOW_STYLE_SHADER
		rect -120 -9.25 917 500
		background "realrtcw_background"
		visible 1
		decoration
	}

itemDef
	{
		name realrtcw_logo
		style WINDOW_STYLE_SHADER
		rect -107 0 480 480
		background "ui/assets/realrtcw_logo.tga"
		visible 1
		decoration
	}

// End of Menu Background

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////                        CONTENT PANEL FRAME              //////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	itemDef
	{
		name panelborder
		rect 12 92 616 366
		style WINDOW_STYLE_ROUNDED
		cornerradius 12
		backcolor 1 1 1 .4
		visible 1
		decoration
	}

	itemDef
	{
		name panelframe
		rect 14 94 612 362
		style WINDOW_STYLE_ROUNDED
		cornerradius 10
		forecolor 1 1 1 1
		backcolor 0 0 0 .88
		visible 1
		decoration
	}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////                        TAB BAR                          //////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	itemDef {
		name tab_gameplay
		text "@MAIN_GAMEPLAY"
		type ITEM_TYPE_BUTTON
		rect 20 100 144 24
		textfont UI_FONT_BIG
		textalign ITEM_ALIGN_CENTER
		textalignx 72
		textaligny 17
		textscale .26
		style WINDOW_STYLE_FILLED
		border 1
		bordercolor .5 .5 .5 .5
		forecolor 1 1 1 1
		backcolor .05 .05 .05 .65
		visible 1
		action { play "sound/misc/kcaction.wav" ;
			close control_menu ; close system_menu ; close sound_menu ;
			open gameplay_menu }
		mouseEnter { transition tab_gameplay 20 100 144 24 16 98 152 28 10 12 ; setitemcolor tab_gameplay backcolor .3 0.5 0.2 .5 }
		mouseExit { transition tab_gameplay 16 98 152 28 20 100 144 24 10 12 ; setitemcolor tab_gameplay backcolor .05 .05 .05 .65 }
	}

	itemDef {
		name tab_controls
		text "@MAIN_CONTROLS"
		type ITEM_TYPE_BUTTON
		rect 172 100 144 24
		textfont UI_FONT_BIG
		textalign ITEM_ALIGN_CENTER
		textalignx 72
		textaligny 17
		textscale .26
		style WINDOW_STYLE_FILLED
		border 1
		bordercolor .5 .5 .5 .5
		forecolor 1 1 1 1
		backcolor .05 .05 .05 .65
		visible 1
		action { play "sound/misc/kcaction.wav" ;
			close gameplay_menu ; close system_menu ; close sound_menu ;
			open control_menu }
		mouseEnter { transition tab_controls 172 100 144 24 168 98 152 28 10 12 ; setitemcolor tab_controls backcolor .3 0.5 0.2 .5 }
		mouseExit { transition tab_controls 168 98 152 28 172 100 144 24 10 12 ; setitemcolor tab_controls backcolor .05 .05 .05 .65 }
	}

	itemDef {
		name tab_graphics
		text "@SYSTEM_GRAPHICS"
		type ITEM_TYPE_BUTTON
		rect 324 100 144 24
		textfont UI_FONT_BIG
		textalign ITEM_ALIGN_CENTER
		textalignx 72
		textaligny 17
		textscale .26
		style WINDOW_STYLE_FILLED
		border 1
		bordercolor .5 .5 .5 .5
		forecolor 1 1 1 1
		backcolor .05 .05 .05 .65
		visible 1
		action { play "sound/misc/kcaction.wav" ;
			close gameplay_menu ; close control_menu ; close sound_menu ;
			open system_menu }
		mouseEnter { transition tab_graphics 324 100 144 24 320 98 152 28 10 12 ; setitemcolor tab_graphics backcolor .3 0.5 0.2 .5 }
		mouseExit { transition tab_graphics 320 98 152 28 324 100 144 24 10 12 ; setitemcolor tab_graphics backcolor .05 .05 .05 .65 }
	}

	itemDef {
		name tab_sound
		text "@SYSTEM_SOUND"
		type ITEM_TYPE_BUTTON
		rect 476 100 144 24
		textfont UI_FONT_BIG
		textalign ITEM_ALIGN_CENTER
		textalignx 72
		textaligny 17
		textscale .26
		style WINDOW_STYLE_FILLED
		border 1
		bordercolor .5 .5 .5 .5
		forecolor 1 1 1 1
		backcolor .05 .05 .05 .65
		visible 1
		action { play "sound/misc/kcaction.wav" ;
			close gameplay_menu ; close control_menu ; close system_menu ;
			open sound_menu }
		mouseEnter { transition tab_sound 476 100 144 24 468 98 152 28 10 12 ; setitemcolor tab_sound backcolor .3 0.5 0.2 .5 }
		mouseExit { transition tab_sound 468 98 152 28 476 100 144 24 10 12 ; setitemcolor tab_sound backcolor .05 .05 .05 .65 }
	}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////                        MAIN MENU                        //////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	itemDef {
		name backmenu
		text "@MAIN_TOMAINMENU"
		type 1
		rect 20 458 150 20
		textfont UI_FONT_BIG
		textalign 0
		textalignx 10
		textaligny 15
		textscale .35
		style WINDOW_STYLE_SKEWED
		forecolor 1 1 1 1
		backcolor 1 1 1 0
		visible 1
		action { play "sound/misc/kcaction.wav" ; close gameplay_menu ; close control_menu ; close system_menu ; close sound_menu ; close setup_menu ; open main }
		mouseEnter { setitemskew backmenu 0 12 ; setitemcolor backmenu backcolor 1 1 1 .92 }
		mouseExit { setitemskew backmenu 0 0 ; setitemcolor backmenu backcolor 1 1 1 0 ; clearfocus }
	}

}

}
