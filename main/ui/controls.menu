#include "ui/menudef.h"

{
\\ CONTROLS TAB \\

menuDef
{
	name "control_menu"
	visible 0
	fullscreen 0
	rect 20 130 600 326
	focusColor 1 .75 0 1
	style 1
	border 1
	onOpen {
		setitemcolor fadebox backcolor 0 0 0 1;
		fadeout fadebox;
		show grpControls;
		hide tipbox
		}

	onEsc {
		close control_menu;
		close setup_menu;
		open main
		}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////                        NON-BIND SETTINGS                //////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	itemDef {
		name ctrl_invertmouse
		group grpControls
		type ITEM_TYPE_MULTI
		text "@CONTROLS_INVERTMOUSE"
		textfont UI_FONT_BIG	// RealRTCWCoop
		cvar "ui_mousePitch"
		cvarFloatList		{ "@GENERAL_NO" 0 "@GENERAL_YES" 1 }
		rect 0 0 600 22
		textalign ITEM_ALIGN_RIGHT
		textalignx 280
		textaligny 16
		textscale .32
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
		forecolor 1 1 1 1
		visible 1
		action { uiScript update ui_mousePitch }
		mouseEnter { setitemcolor ctrl_invertmouse backcolor .3 0.5 0.2 .25 ; show tip_invertmouse ; show tipbox }
		mouseExit { setitemcolor ctrl_invertmouse backcolor 1 1 1 .07 ; hide tip_invertmouse ; hide tipbox }
    		}

	itemDef {
		name ctrl_smoothmouse
		group grpControls
		type ITEM_TYPE_MULTI
		text "@CONTROLS_SMOOTHMOUSE"
		textfont UI_FONT_BIG	// RealRTCWCoop
		cvar "m_filter"
		cvarFloatList		{ "@GENERAL_NO" 0 "@GENERAL_YES" 1 }
		rect 0 24 600 22
		textalign ITEM_ALIGN_RIGHT
		textalignx 280
		textaligny 16
		textscale .32
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
		forecolor 1 1 1 1
		visible 1
		mouseEnter { setitemcolor ctrl_smoothmouse backcolor .3 0.5 0.2 .25 ; show tip_smoothmouse ; show tipbox }
		mouseExit { setitemcolor ctrl_smoothmouse backcolor 1 1 1 .07 ; hide tip_smoothmouse ; hide tipbox }
    		}

	itemDef {
		name ctrl_mousesens
		group grpControls
		type ITEM_TYPE_SLIDER
		text "@CONTROLS_MOUSESENSITIVITY"
		textfont UI_FONT_BIG	// RealRTCWCoop
		cvarfloat "sensitivity" 5 1 50
		rect 0 48 600 22
		textalign ITEM_ALIGN_RIGHT
		textalignx 280
		textaligny 16
		textscale .32
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
		forecolor 1 1 1 1
		visible 1
		mouseEnter { setitemcolor ctrl_mousesens backcolor .3 0.5 0.2 .25 ; show tip_mousesens ; show tipbox }
		mouseExit { setitemcolor ctrl_mousesens backcolor 1 1 1 .07 ; hide tip_mousesens ; hide tipbox }
    		}

	itemDef {
		name ctrl_zoomweap
		group grpControls
		type ITEM_TYPE_MULTI
		text "@CONTROLS_FORZOOMING"
		textfont UI_FONT_BIG	// RealRTCWCoop
		cvar "cg_useWeapsForZoom"
		cvarFloatList { "@GENERAL_OFF" 0 "@CONTROLS_ZOOM_ON_NORMAL" 1 "@CONTROLS_ZOOM_ON_REVERSE" 2 }
		rect 0 72 600 22
		textalign ITEM_ALIGN_RIGHT
		textalignx 280
		textaligny 16
		textscale .32
		forecolor 1 1 1 1
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
		visible 1
		mouseEnter { setitemcolor ctrl_zoomweap backcolor .3 0.5 0.2 .25 ; show tip_zoomweap ; show tipbox }
		mouseExit { setitemcolor ctrl_zoomweap backcolor 1 1 1 .07 ; hide tip_zoomweap ; hide tipbox }
		}

	itemDef {
		name ctrl_alwaysrun
		group grpControls
		type ITEM_TYPE_MULTI
		text "@CONTROLS_ALWAYSRUN"
		textfont UI_FONT_BIG	// RealRTCWCoop
		cvar "cl_run"
		cvarFloatList		{ "@GENERAL_NO" 0 "@GENERAL_YES" 1 }
		rect 0 96 600 22
		textalign ITEM_ALIGN_RIGHT
		textalignx 280
		textaligny 16
		textscale .32
		forecolor 1 1 1 1
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
		visible 1
		mouseEnter { setitemcolor ctrl_alwaysrun backcolor .3 0.5 0.2 .25 ; show tip_alwaysrun ; show tipbox }
		mouseExit { setitemcolor ctrl_alwaysrun backcolor 1 1 1 .07 ; hide tip_alwaysrun ; hide tipbox }
    		}

	itemDef {
		name ctrl_autoswitch
		group grpControls
		type ITEM_TYPE_MULTI
		text "@CONTROLS_AUTOSWITCH"
		textfont UI_FONT_BIG	// RealRTCWCoop
		cvar "cg_autoswitch"
		cvarFloatList { "@GENERAL_OFF" 0 "@CONTROLS_AUTOSWITCH_ALWAYS" 1 "@CONTROLS_AUTOSWITCH_IFNEW" 2 "@CONTROLS_AUTOSWITCH_IFBETTER" 3 "@CONTROLS_AUTOSWITCH_NEWORBETTER" 4 "@CONTROLS_AUTOSWITCH_NEWANDBETTER" 5 }
		rect 0 120 600 22
		textalign ITEM_ALIGN_RIGHT
		textalignx 280
		textaligny 16
		textscale .32
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
		forecolor 1 1 1 1
		visible 1
		mouseEnter { setitemcolor ctrl_autoswitch backcolor .3 0.5 0.2 .25 ; show tip_autoswitch ; show tipbox }
		mouseExit { setitemcolor ctrl_autoswitch backcolor 1 1 1 .07 ; hide tip_autoswitch ; hide tipbox }
		}

	itemDef {
		name ctrl_autopickup
		group grpControls
		type ITEM_TYPE_MULTI
		text "@CONTROLS_AUTOPICKUP"
		textfont UI_FONT_BIG	// RealRTCWCoop
		cvar "cg_autoactivate"
		cvarFloatList		{ "@GENERAL_NO" 0 "@GENERAL_YES" 1 }
		rect 0 144 600 22
		textalign ITEM_ALIGN_RIGHT
		textalignx 280
		textaligny 16
		textscale .32
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
		forecolor 1 1 1 1
		visible 1
		mouseEnter { setitemcolor ctrl_autopickup backcolor .3 0.5 0.2 .25 ; show tip_autopickup ; show tipbox }
		mouseExit { setitemcolor ctrl_autopickup backcolor 1 1 1 .07 ; hide tip_autopickup ; hide tipbox }
		}

	itemDef {
		name ctrl_quickmsg
		group grpControls
		type ITEM_TYPE_MULTI
		text "@CONTROLS_QUICKMESSAGEMODE"
		textfont UI_FONT_BIG	// RealRTCWCoop
		cvar "cg_quickMessageAlt"
		cvarFloatList { "@CONTROLS_QUICKMSG_ALPHA" 0 "@CONTROLS_QUICKMSG_NUMERIC" 1 }
		rect 0 168 600 22
		textalign ITEM_ALIGN_RIGHT
		textalignx 280
		textaligny 16
		textscale .32
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
		forecolor 1 1 1 1
		visible 1
		mouseEnter { setitemcolor ctrl_quickmsg backcolor .3 0.5 0.2 .25 ; show tip_quickmsg ; show tipbox }
		mouseExit { setitemcolor ctrl_quickmsg backcolor 1 1 1 .07 ; hide tip_quickmsg ; hide tipbox }
		}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////                        KEYBOARD BINDS BUTTON            //////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	itemDef {
		name editkeyboard
		group grpControls
		text "@CONTROLS_EDITKEYBOARD"
		type ITEM_TYPE_BUTTON
		rect 180 206 240 32
		textfont UI_FONT_BIG
		textalign ITEM_ALIGN_CENTER
		textalignx 120
		textaligny 21
		textscale .28
		style WINDOW_STYLE_FILLED
		border 1
		bordercolor .5 .5 .5 .5
		forecolor 1 1 1 1
		backcolor .1 .1 .1 .3
		visible 1
		action { play "sound/misc/kcaction.wav" ;
			close control_menu ;
			open editkeyboard_menu ;
			uiScript loadControls }
		mouseEnter { setitemcolor editkeyboard backcolor .3 0.5 0.2 .5 ; show tip_editkeyboard ; show tipbox }
		mouseExit { setitemcolor editkeyboard backcolor .1 .1 .1 .3 ; hide tip_editkeyboard ; hide tipbox }
	}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////                        HOVER TIP BOX                    //////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	itemDef {
		name tipbox
		style WINDOW_STYLE_FILLED
		rect 0 264 600 30
		backcolor 0 0 0 .55
		visible 0
		decoration
	}

	itemDef {
		name tip_invertmouse
		group grpControlsTip
		style WINDOW_STYLE_EMPTY
		rect 15 264 570 30
		text "@CONTROLS_TIP_INVERTMOUSE"
		textfont UI_FONT_BIG
		textscale .23
		textalign ITEM_ALIGN_LEFT
		textalignx 0
		textaligny 20
		forecolor 1 1 1 1
		visible 0
		decoration
	}

