itemDef {
	name ctr_look
	text "@CONTROLS_LOOK"
	textfont UI_FONT_BIG	// RealRTCWCoop
	type ITEM_TYPE_BUTTON
	textscale .23
	group grpControlbutton
	style WINDOW_STYLE_FILLED
	rect 2 4 107 20
	textalign ITEM_ALIGN_CENTER
	textalignx 53
	textaligny 14
	border 1
	bordercolor .5 .5 .5 .5
	forecolor 1 1 1 1
	backcolor .3 0.5 0.2 .5
	visible 1
	action { play "sound/misc/kcaction.wav" ;
	hide grpControls ; show look ;
	setitemcolor ctr_look backcolor .3 0.5 0.2 .5 ; setitemcolor ctr_move backcolor .1 .1 .1 .3 ; setitemcolor ctr_shoot backcolor .1 .1 .1 .3 ; setitemcolor ctr_miscellaneous backcolor .1 .1 .1 .3 }
	}
	

	itemDef {
		name look
		group grpControls
		type ITEM_TYPE_MULTI
		text "@CONTROLS_PLAYERVIEW"
		textfont UI_FONT_BIG	// RealRTCWCoop
		cvar "cg_thirdperson"
		cvarFloatList { "@CONTROLS_VIEW_FIRSTPERSON" 0 "@CONTROLS_VIEW_THIRDPERSON" 1 }
		rect 82 30 290 12 
		textalign ITEM_ALIGN_RIGHT
		textalignx 142 
		textaligny 10    
		textscale .23 
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
