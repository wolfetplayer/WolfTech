#include "ui/menudef.h"
{

  assetGlobalDef {
	#include "ui/fonts.menu"
	cursor "ui/assets/3_cursor3"				// cursor
	gradientBar "ui/assets/gradientbar2.tga"	// gradient bar
	itemFocusSound "sound/misc/menu2.wav"		// sound for item getting focus (via keyboard or mouse )

	fadeClamp 1.0								// sets the fadeup alpha
	fadeCycle 1									// how often fade happens in milliseconds
	fadeAmount 0.1								// amount to adjust alpha per cycle

	shadowColor 0.1 0.1 0.1 0.25				// shadow color
  	}


\\ INGAME MENU \\

menuDef {
	name "ingame"
	visible 0
	fullScreen 0
	outOfBoundsClick			// this closes the window if it gets a click out of the rectangle
	rect 0 0 640 480
	focusColor 0 0 0 1			// black, so hovered button text reads over the white skewed highlight
	disableColor .5 .5 .5 1
	onOpen
	{
		setCvar cg_draw2D "0";

		show grpIngame;

		hide grpingametip;
		hide tipbox;

		open ingame_quick
	}
	onClose { setCvar cg_draw2D "1" }
	onEsc { setCvar cg_draw2D "1" }

itemDef
	{
		name realrtcw_logo
		style WINDOW_STYLE_SHADER
		rect -107 0 480 480
		background "ui/assets/realrtcw_logo.tga"
		visible 1
		decoration
	}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////                        INGAME MENU BUTTONS  //////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	// JOIN GAME BUTTON
	itemDef {
	    name join
		group grpIngame
	    text "@INGAME_JOIN"
	    type 1
	    rect 10 150 178 30
	    visible 1
	textalign 0
	textalignx 10
	textaligny 21
	textscale .60
		textfont UI_FONT_BIG
		style WINDOW_STYLE_SKEWED
		forecolor 1 1 1 1
		backcolor 1 1 1 0

    	action {
			close ingame_join;
			close ingame_callvote;
			close ingame_controls;
			close ingame_options;
			close ingame_system;
			open ingame_join ;	close ingame_quick;
			hide grpIngame ;
			uiScript RefreshServers ;
			uiScript RefreshFilter }

	    mouseEnter { setitemskew join 0 18 ; setitemcolor join backcolor 1 1 1 .92 ; show tip_join ; show tipbox ; transition join 10 150 178 30 18 148 186 34 10 12 }
	    mouseExit { setitemskew join 0 0 ; setitemcolor join backcolor 1 1 1 0 ; clearfocus ; hide tip_join ; hide tipbox ; transition join 18 148 186 34 10 150 178 30 10 12 }
	}

	// CALL VOTE BUTTON
	itemDef {
		name vote
		group grpIngame
		text "@INGAME_VOTE"
		type 1
	    rect 10 192 160 30
		visible 1
		textfont UI_FONT_BIG
	textalign 0
	textalignx 10
	textaligny 21
	textscale .60
		style WINDOW_STYLE_SKEWED
		forecolor 1 1 1 1
		backcolor 1 1 1 0

    	action {
			close ingame_join;
			close ingame_callvote;
			close ingame_controls;
			close ingame_options;
			close ingame_system;
			open ingame_callvote ; close ingame_quick }

	    mouseEnter { setitemskew vote 0 18 ; setitemcolor vote backcolor 1 1 1 .92 ; show tip_vote ; show tipbox ; transition vote 10 192 160 30 18 190 168 34 10 12 }
	    mouseExit { setitemskew vote 0 0 ; setitemcolor vote backcolor 1 1 1 0 ; clearfocus ; hide tip_vote ; hide tipbox ; transition vote 18 190 168 34 10 192 160 30 10 12 }
    }

    // CONTROLS BUTTON
	itemDef {
		name controls
		group grpIngame
		text "@INGAME_CONTROLS"
		type 1
	    rect 10 234 134 30
		visible 1
		textfont UI_FONT_BIG
	textalign 0
	textalignx 10
	textaligny 21
	textscale .60
		style WINDOW_STYLE_SKEWED
		forecolor 1 1 1 1
		backcolor 1 1 1 0

		action {
		close ingame_join;
		close ingame_callvote;
		close ingame_controls;
		close ingame_options;
		close ingame_system;
		open ingame_controls ; close ingame_quick }

	    mouseEnter { setitemskew controls 0 18 ; setitemcolor controls backcolor 1 1 1 .92 ; show tip_controls ; show tipbox ; transition controls 10 234 134 30 18 232 142 34 10 12 }
	    mouseExit { setitemskew controls 0 0 ; setitemcolor controls backcolor 1 1 1 0 ; clearfocus ; hide tip_controls ; hide tipbox ; transition controls 18 232 142 34 10 234 134 30 10 12 }
    }

    // OPTIONS BUTTON
	itemDef {
        name options
        text "@INGAME_OPTIONS"
		group grpIngame
 	    type 1
	    rect 10 276 121 30
	textalign 0
	textalignx 10
	textaligny 21
	textscale .60
		textfont UI_FONT_BIG
	    visible 1
		style WINDOW_STYLE_SKEWED
		forecolor 1 1 1 1
		backcolor 1 1 1 0

		action {
		close ingame_join;
		close ingame_callvote;
		close ingame_controls;
		close ingame_options;
		close ingame_system;
		open ingame_options ; close ingame_quick }

	    mouseEnter { setitemskew options 0 18 ; setitemcolor options backcolor 1 1 1 .92 ; show tip_options ; show tipbox ; transition options 10 276 121 30 18 274 129 34 10 12 }
	    mouseExit { setitemskew options 0 0 ; setitemcolor options backcolor 1 1 1 0 ; clearfocus ; hide tip_options ; hide tipbox ; transition options 18 274 129 34 10 276 121 30 10 12 }
	}

	// SYSTEM BUTTON
	itemDef {
        name system
        text "@INGAME_SYSTEM"
		group grpIngame
 	    type 1
	    rect 10 318 107 30
		textfont UI_FONT_BIG
	textalign 0
	textalignx 10
	textaligny 21
	textscale .60
	    visible 1
		style WINDOW_STYLE_SKEWED
		forecolor 1 1 1 1
		backcolor 1 1 1 0

		action {
		close ingame_join;
		close ingame_callvote;
		close ingame_controls;
		close ingame_options;
		close ingame_system;
		open ingame_system ; close ingame_quick }

	    mouseEnter { setitemskew system 0 18 ; setitemcolor system backcolor 1 1 1 .92 ; show tip_system ; show tipbox ; transition system 10 318 107 30 18 316 115 34 10 12 }
	    mouseExit { setitemskew system 0 0 ; setitemcolor system backcolor 1 1 1 0 ; clearfocus ; hide tip_system ; hide tipbox ; transition system 18 316 115 34 10 318 107 30 10 12 }
	}

	// LEAVE GAME BUTTON
	itemDef {
        name leave
        text "@INGAME_LEAVE"
		group grpIngame
 	    type 1
	    rect 10 360 178 30
		textfont UI_FONT_BIG
	textalign 0
	textalignx 10
	textaligny 21
	textscale .60
	    visible 1
		style WINDOW_STYLE_SKEWED
		forecolor 1 1 1 1
		backcolor 1 1 1 0

		action { uiscript leave }

	    mouseEnter { setitemskew leave 0 18 ; setitemcolor leave backcolor 1 1 1 .92 ; show tip_leave ; show tipbox ; transition leave 10 360 178 30 18 358 186 34 10 12 }
	    mouseExit { setitemskew leave 0 0 ; setitemcolor leave backcolor 1 1 1 0 ; clearfocus ; hide tip_leave ; hide tipbox ; transition leave 18 358 186 34 10 360 178 30 10 12 }
	}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////                        HOVER TIP BOX        //////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	itemDef
	{
		name tipbox
		style WINDOW_STYLE_FILLED
		rect 10 410 460 40
		backcolor 0 0 0 0.55
		visible 0
		decoration
	}

	itemDef {
		name tip_join
		group grpingametip
		style WINDOW_STYLE_EMPTY
		rect 20 410 440 40
		text "@INGAME_TIP_JOIN"
		textfont UI_FONT_BIG
		textscale .23
		textalign 0
		textalignx 0
		textaligny 26
		forecolor 1 1 1 1
		visible 0
		decoration
	}

	itemDef {
		name tip_vote
		group grpingametip
		style WINDOW_STYLE_EMPTY
		rect 20 410 440 40
		text "@INGAME_TIP_VOTE"
		textfont UI_FONT_BIG
		textscale .23
		textalign 0
		textalignx 0
		textaligny 26
		forecolor 1 1 1 1
		visible 0
		decoration
	}

	itemDef {
		name tip_controls
		group grpingametip
		style WINDOW_STYLE_EMPTY
		rect 20 410 440 40
		text "@INGAME_TIP_CONTROLS"
		textfont UI_FONT_BIG
		textscale .23
		textalign 0
		textalignx 0
		textaligny 26
		forecolor 1 1 1 1
		visible 0
		decoration
	}

	itemDef {
		name tip_options
		group grpingametip
		style WINDOW_STYLE_EMPTY
		rect 20 410 440 40
		text "@INGAME_TIP_OPTIONS"
		textfont UI_FONT_BIG
		textscale .23
		textalign 0
		textalignx 0
		textaligny 26
		forecolor 1 1 1 1
		visible 0
		decoration
	}

	itemDef {
		name tip_system
		group grpingametip
		style WINDOW_STYLE_EMPTY
		rect 20 410 440 40
		text "@INGAME_TIP_SYSTEM"
		textfont UI_FONT_BIG
		textscale .23
		textalign 0
		textalignx 0
		textaligny 26
		forecolor 1 1 1 1
		visible 0
		decoration
	}

	itemDef {
		name tip_leave
		group grpingametip
		style WINDOW_STYLE_EMPTY
		rect 20 410 440 40
		text "@INGAME_TIP_LEAVE"
		textfont UI_FONT_BIG
		textscale .23
		textalign 0
		textalignx 0
		textaligny 26
		forecolor 1 1 1 1
		visible 0
		decoration
	}

}

}
