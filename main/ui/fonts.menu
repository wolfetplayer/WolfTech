// Central font bindings: the ONE place mapping a UI_FONT_* id to its file/size. #include this instead of hand-typing "font" lines per menu.
// Console is still the legacy bitmap font (never got a working TTF wiring - reverted).
// TEMP: everything below points at StardosStencilRegular for a full-system preview; revert to "ariblk"/"courbd" to restore the old look.

font            "StardosStencilRegular" 16    // UI_FONT_DEFAULT / UI_FONT_NORMAL - legacy default text font
smallFont       "StardosStencilRegular" 12    // UI_FONT_SMALL
bigFont         "StardosStencilRegular" 24    // UI_FONT_BIG
handwritingFont "StardosStencilRegular" 17    // UI_FONT_HANDWRITING - clipboard/notebook pages

font UI_FONT_ARIBLK_27 "StardosStencilRegular" 27    // main menu headings
font UI_FONT_COURBD_21 "StardosStencilRegular" 21    // main menu list items
font UI_FONT_COURBD_24 "StardosStencilRegular" 24    // HUD numeric readouts, scoreboard titles
font UI_FONT_COURBD_12 "StardosStencilRegular" 12    // chat/subtitle text, scoreboard rows
