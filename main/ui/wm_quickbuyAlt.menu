		textfont	UI_FONT_NORMAL
		textscale	.25
		textalign		ITEM_ALIGN_LEFT
		text			"@QUICKBUY_ALT_TAB_RIFLES"
		decoration
	}
	execKey "3" { close wm_quickbuyAlt; open altwm_buyrifle }

	itemDef {
		name			"window"
		visible			1
		rect			10 88 128 16
		origin			ORIGIN_QUICKBUY
		forecolor		1 1 1 1
		backcolor		0 0 0 0
		textfont	UI_FONT_NORMAL
		textscale	.25
		textalign		ITEM_ALIGN_LEFT
		text			"@QUICKBUY_ALT_TAB_HEAVY"
		decoration
	}
	execKey "4" { close wm_quickbuyAlt; open altwm_buyheavy }

	itemDef {
		name			"window"
		visible			1
		rect			10 104 128 16
		origin			ORIGIN_QUICKBUY
		forecolor		1 1 1 1
		backcolor		0 0 0 0
		textfont	UI_FONT_NORMAL
		textscale	.25
		textalign		ITEM_ALIGN_LEFT
		text			"@QUICKBUY_ALT_TAB_EXPLOSIVES"
