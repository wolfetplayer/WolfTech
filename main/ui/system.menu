itemDef {
		name graphicsapply
		text "@SYSTEM_APPLY"
		textfont UI_FONT_BIG	// RealRTCWCoop
		type 1	
		textscale .25
		style WINDOW_STYLE_FILLED
		group grpsystem

		rect 181 310 100 20
		textalign 1
		textalignx 50
		textaligny 15
		forecolor 1 1 1 1
		backcolor .1 .1 .1 .1 
		visible 1
		border 1
		bordercolor .5 .5 .5 .5
		action { play "sound/misc/kcaction.wav" ; 
open vid_restart_popmenu ; hide graphics ; hide graphicsapply }
		mouseEnter { setitemcolor graphicsapply backcolor .3 .5 .2 .25 }
      	mouseExit { setitemcolor graphicsapply backcolor .1 .1 .1 .1 }

		}



itemDef {
	name ctr_rend2
	text "@SYSTEM_REND2"
	textfont UI_FONT_BIG	// RealRTCWCoop
	type ITEM_TYPE_BUTTON
	textscale .22
	group grpSystembutton
	style WINDOW_STYLE_FILLED
	rect 149 4 145 20
	textalign ITEM_ALIGN_CENTER
	textalignx 72
	textaligny 14
	border 1
	bordercolor .5 .5 .5 .5
	forecolor 1 1 1 1
	backcolor .1 .1 .1 .3
	visible 1
	action { play "sound/misc/kcaction.wav" ;
	hide grpSystem ; hide grpapplysystem ; hide graphicsapply ;
	show rend2page ; show rend2apply ;
	setitemcolor ctr_rend2 backcolor .3 0.5 0.2 .5 ; setitemcolor ctr_graphics backcolor .1 .1 .1 .3 ; setitemcolor ctr_other backcolor .1 .1 .1 .3 }
	}


