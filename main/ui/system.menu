#include "ui/menudef.h"

{
\\ SETUP MENU \\

menuDef {
	name "system_menu"
	visible 0
	fullscreen 0
	rect 20 130 600 326
	focusColor 1 .75 0 1
	style 1
	border 1
	onOpen { setitemcolor fadebox backcolor 0 0 0 1 ; fadeout fadebox ; hide advanced ; hide rend2page ; hide rend2apply ; hide performance ; show graphics ; show graphicsapply ; show grpGraphicsNav ; hide tipbox ; hide grpGraphicsTip }
	onEsc { close system_menu ; close setup_menu ; open main }

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////                        NORMAL (ALWAYS VISIBLE)          //////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

itemDef {
	name sys_renderer
	group graphics
	type ITEM_TYPE_MULTI
	text "@SYSTEM_RENDERER"
	textfont UI_FONT_BIG	// RealRTCWCoop
	cvar "cl_renderer"
	cvarStrList { "@SYSTEM_RENDERER_OPENGL1", "opengl1", "@SYSTEM_RENDERER_REND2", "rend2"  }
	rect 0 0 600 22
	textalign ITEM_ALIGN_RIGHT
	textalignx 280
	textaligny 16
	textscale .32
	style WINDOW_STYLE_FILLED
	backcolor 1 1 1 .07
	forecolor 1 1 1 1
	visible 0
	action { uiScript glCustom }
	mouseEnter { setitemcolor sys_renderer backcolor .3 0.5 0.2 .25 ; show tip_sys_renderer ; show tipbox }
	mouseExit { setitemcolor sys_renderer backcolor 1 1 1 .07 ; hide tip_sys_renderer ; hide tipbox }
	}

itemDef {
	name sys_quality
	group graphics
	text "@SYSTEM_QUALITY"
	textfont UI_FONT_BIG	// RealRTCWCoop
   	type ITEM_TYPE_MULTI
	cvar "ui_glCustom"
	cvarFloatList { "@SYSTEM_LEVEL_HIGHQUALITY" 0 "@SYSTEM_LEVEL_NORMAL" 1 "@SYSTEM_LEVEL_FAST" 2 "@SYSTEM_LEVEL_FASTEST" 3 "@SYSTEM_LEVEL_CUSTOM" 4 }

	cvarTest		"ui_glCustom"
	hideCvar		{ "999" }	// 999 is 'recommended'

	rect 0 24 600 22
   	textalign ITEM_ALIGN_RIGHT
   	textalignx 280
   	textaligny 16
	textscale .32
	style WINDOW_STYLE_FILLED
	backcolor 1 1 1 .07
	forecolor 1 1 1 1
	visible 0
	action { uiScript update "ui_glCustom" }
	mouseEnter { setitemcolor sys_quality backcolor .3 0.5 0.2 .25 ; show tip_sys_quality ; show tipbox }
	mouseExit { setitemcolor sys_quality backcolor 1 1 1 .07 ; hide tip_sys_quality ; hide tipbox }
	}

	itemDef {
		name sys_quality_recommended
		group graphics
		text "@SYSTEM_QUALITY_RECOMMENDED"
		textfont UI_FONT_BIG	// RealRTCWCoop
		type ITEM_TYPE_BUTTON

		cvarTest		"ui_glCustom"
		showCvar		{ "999" }	// 999 is 'recommended'

		rect 0 24 600 22
		textalign ITEM_ALIGN_CENTER
		textalignx 290
		textaligny 16
		textscale .32
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
		forecolor 1 1 1 1
		visible 0
		action {
			setcvar ui_glCustom 0;	// go back to regular selection group
			uiScript update "ui_glCustom" }
		mouseEnter { setitemcolor sys_quality_recommended backcolor .3 0.5 0.2 .25 ; show tip_sys_quality_recommended ; show tipbox }
		mouseExit { setitemcolor sys_quality_recommended backcolor 1 1 1 .07 ; hide tip_sys_quality_recommended ; hide tipbox }
		}

		itemDef {
   		name sys_videomode
		group graphics
   		type ITEM_TYPE_COMBO
		text "@SYSTEM_VIDEOMODE_LABEL"
		textfont UI_FONT_BIG	// RealRTCWCoop
		cvar "r_mode"
		cvarFloatList {  "@SYSTEM_VM_640X480" 3 "@SYSTEM_VM_800X600" 4 "@SYSTEM_VM_960X720" 5 "@SYSTEM_VM_1024X768" 6 "@SYSTEM_VM_1152X864" 7 "@SYSTEM_VM_1280X1024" 8 "@SYSTEM_VM_1600X1200" 9 "@SYSTEM_VM_2048X1536" 10 "@SYSTEM_VM_WIDESCREEN" 11 }
//		"320*240" 0 "400*300" 1 "512*384" 2
		rect 0 48 600 22
	  	textalign ITEM_ALIGN_RIGHT
	  	textalignx 280
	  	textaligny 16
		textscale .32
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
	  	forecolor 1 1 1 1
	  	visible 0
		action { uiScript glCustom }
		mouseEnter { setitemcolor sys_videomode backcolor .3 0.5 0.2 .25 ; show tip_sys_videomode ; show tipbox }
		mouseExit { setitemcolor sys_videomode backcolor 1 1 1 .07 ; hide tip_sys_videomode ; hide tipbox }
	}

	itemDef {
		name sys_aspectratio
		group graphics
		type ITEM_TYPE_MULTI
