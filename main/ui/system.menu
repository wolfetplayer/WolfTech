	}

	itemDef {
  		name sys_brightness
		group graphics
	  	type ITEM_TYPE_SLIDER
		text "@SYSTEM_BRIGHTNESS_LABEL"
		textfont UI_FONT_BIG	// RealRTCWCoop
		cvarfloat "r_gamma" 1 0.5 3
 		rect 0 144 600 22
	  	textalign ITEM_ALIGN_RIGHT
	  	textalignx 280
	  	textaligny 16
		textscale .32
		style WINDOW_STYLE_FILLED
		backcolor 1 1 1 .07
	  	forecolor 1 1 1 1

		cvarTest "r_ignorehwgamma"
//		showcvar { "1" }

	  	visible 0
		action { uiScript glCustom }
		mouseenter { setitemcolor sys_brightness backcolor .3 0.5 0.2 .25 ; show tip_sys_brightness ; show tipbox }
		mouseexit { setitemcolor sys_brightness backcolor 1 1 1 .07 ; hide tip_sys_brightness ; hide tipbox }
		}

itemDef {
		name graphicsapply
		text "@SYSTEM_APPLY"
		textfont UI_FONT_BIG	// RealRTCWCoop
		type 1
		textscale .25
		style WINDOW_STYLE_FILLED
		group grpsystem

		rect 240 172 100 20
		textalign 1
		textalignx 50
		textaligny 15
		forecolor 1 1 1 1
		backcolor .1 .1 .1 .1
		visible 1
		border 1
		bordercolor .5 .5 .5 .5
		action { play "sound/misc/kcaction.wav" ;
open vid_restart_popmenu ; hide graphics ; hide graphicsapply ; hide tipbox ; hide grpGraphicsTip }
		mouseEnter { setitemcolor graphicsapply backcolor .3 .5 .2 .25 ; show tip_graphicsapply ; show tipbox }
      	mouseExit { setitemcolor graphicsapply backcolor .1 .1 .1 .1 ; hide tip_graphicsapply ; hide tipbox }

		}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////                        SUB-SECTION NAV ROWS             //////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

itemDef {
	name tab_advanced
	group grpGraphicsNav
	text "@SYSTEM_ADVANCED"
	textfont UI_FONT_BIG	// RealRTCWCoop
	type ITEM_TYPE_BUTTON
	textalign ITEM_ALIGN_CENTER
	textalignx 290
	textaligny 16
	textscale .32
	rect 0 198 600 22
	style WINDOW_STYLE_FILLED
	backcolor 1 1 1 .07
	forecolor 1 1 1 1
	visible 1
	action { play "sound/misc/kcaction.wav" ;
	hide graphics ; hide graphicsapply ; hide grpGraphicsNav ; hide tipbox ; hide grpGraphicsTip ;
	show advanced }
	mouseEnter { setitemcolor tab_advanced backcolor .3 0.5 0.2 .25 ; show tip_tab_advanced ; show tipbox }
	mouseExit { setitemcolor tab_advanced backcolor 1 1 1 .07 ; hide tip_tab_advanced ; hide tipbox }
	}

itemDef {
	name tab_performance
	group grpGraphicsNav
	text "@SYSTEM_PERFORMANCE"
	textfont UI_FONT_BIG	// RealRTCWCoop
	type ITEM_TYPE_BUTTON
	textalign ITEM_ALIGN_CENTER
	textalignx 290
	textaligny 16
	textscale .32
	rect 0 222 600 22
	style WINDOW_STYLE_FILLED
	backcolor 1 1 1 .07
	forecolor 1 1 1 1
	visible 1
	action { play "sound/misc/kcaction.wav" ;
	hide graphics ; hide graphicsapply ; hide grpGraphicsNav ; hide tipbox ; hide grpGraphicsTip ;
	show performance }
	mouseEnter { setitemcolor tab_performance backcolor .3 0.5 0.2 .25 ; show tip_tab_performance ; show tipbox }
	mouseExit { setitemcolor tab_performance backcolor 1 1 1 .07 ; hide tip_tab_performance ; hide tipbox }
	}

itemDef {
	name tab_rend2
	group grpGraphicsNav
	text "@SYSTEM_REND2"
	textfont UI_FONT_BIG	// RealRTCWCoop
	type ITEM_TYPE_BUTTON
	textalign ITEM_ALIGN_CENTER
	textalignx 290
	textaligny 16
	textscale .32
	rect 0 246 600 22
	style WINDOW_STYLE_FILLED
	backcolor 1 1 1 .07
	forecolor 1 1 1 1
	visible 1
	action { play "sound/misc/kcaction.wav" ;
	hide graphics ; hide graphicsapply ; hide grpGraphicsNav ; hide tipbox ; hide grpGraphicsTip ;
	show rend2page ; show rend2apply }
	mouseEnter { setitemcolor tab_rend2 backcolor .3 0.5 0.2 .25 ; show tip_tab_rend2 ; show tipbox }
	mouseExit { setitemcolor tab_rend2 backcolor 1 1 1 .07 ; hide tip_tab_rend2 ; hide tipbox }
	}

