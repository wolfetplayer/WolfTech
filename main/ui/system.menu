	  	forecolor 1 1 1 1
	  	visible 0
		action { uiScript glCustom }
		mouseEnter { setitemcolor sys_aspectratio backcolor .3 0.5 0.2 .25 ; show tip_sys_aspectratio ; show tipbox }
		mouseExit { setitemcolor sys_aspectratio backcolor 1 1 1 .07 ; hide tip_sys_aspectratio ; hide tipbox }
	}

	itemDef {
