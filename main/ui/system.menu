itemDef {
	name rend2apply
	text "@SYSTEM_APPLY"
	textfont UI_FONT_BIG	// RealRTCWCoop
	type ITEM_TYPE_BUTTON
	textscale .25
	style WINDOW_STYLE_FILLED
	group rend2apply
	rect 390 160 100 20
	textalign 1
	textalignx 50
	textaligny 15
	forecolor 1 1 1 1
	backcolor .1 .1 .1 .1
	visible 0
	border 1
	bordercolor .5 .5 .5 .5
	action { play "sound/misc/kcaction.wav" ;
	open vid_restart_popmenu ; hide rend2page ; hide rend2apply }
	mouseEnter { setitemcolor rend2apply backcolor .3 .5 .2 .25 ; show tip_rend2apply ; show tipbox }
	mouseExit { setitemcolor rend2apply backcolor .1 .1 .1 .1 ; hide tip_rend2apply ; hide tipbox }
	}

itemDef {
	name r2_back
	group rend2page
	type ITEM_TYPE_BUTTON
	text "@MAIN_BACK"
	textfont UI_FONT_BIG	// RealRTCWCoop
	textscale .25
	style WINDOW_STYLE_FILLED
	rect 390 190 100 20
	textalign 1
	textalignx 50
	textaligny 15
	forecolor 1 1 1 1
	backcolor .1 .1 .1 .1
	visible 0
	border 1
	bordercolor .5 .5 .5 .5
	action { play "sound/misc/kcaction.wav" ; hide rend2page ; hide rend2apply ; hide tipbox ; hide grpGraphicsTip ; show graphics ; show graphicsapply ; show grpGraphicsNav }
	mouseEnter { setitemcolor r2_back backcolor .3 .5 .2 .25 ; show tip_r2_back ; show tipbox }
	mouseExit { setitemcolor r2_back backcolor .1 .1 .1 .1 ; hide tip_r2_back ; hide tipbox }
	}

