itemDef {
	name rend2apply
	text "@SYSTEM_APPLY"
	textfont UI_FONT_BIG	// RealRTCWCoop
	type ITEM_TYPE_BUTTON
	textscale .25
	style WINDOW_STYLE_FILLED
	group rend2apply
	rect 181 310 100 20
	textalign 1
	textalignx 50
	textaligny 15
	forecolor 1 1 1 1
	backcolor .1 .1 .1 .1
	visible 0
	border 1
	bordercolor .5 .5 .5 .5
	action { play "sound/misc/kcaction.wav" ;
	open vid_restart_popmenu ; hide rend2page ; hide rend2apply }
	mouseEnter { setitemcolor rend2apply backcolor .3 .5 .2 .25 }
	mouseExit { setitemcolor rend2apply backcolor .1 .1 .1 .1 }
	}

