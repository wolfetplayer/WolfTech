#include "ui/menudef.h"

{
\\ SETUP MENU \\




menuDef {
	name "system_menu"
	visible 0
	fullscreen 0
	rect 220 110 443 370
	focusColor 1 .75 0 1
	style 1
	border 1
	onOpen { setitemcolor fadebox backcolor 0 0 0 1 ; fadeout fadebox ; hide grpSystem ; hide grpapplysystem ; hide rend2page ; hide rend2apply ; show graphics ; show graphicsapply ; setitemcolor ctr_graphics backcolor .3 0.5 0.2 .5 ; setitemcolor ctr_rend2 backcolor .1 .1 .1 .3 ; setitemcolor ctr_other backcolor .1 .1 .1 .3 }
	onEsc { close system_menu ; close setup_menu ; open main }




	itemDef 
	{
		name window
		group grpSystembutton
		rect 0 2 443 330
		style WINDOW_STYLE_FILLED
		border 1
		bordercolor .5 .5 .5 .5
		forecolor 1 1 1 1
		backcolor 0 0 0 .5
		visible 1
		decoration
	}




// 	System		//

itemDef {
	name ctr_graphics
	text "@SYSTEM_GRAPHICS"
	textfont UI_FONT_BIG	// RealRTCWCoop
	type ITEM_TYPE_BUTTON
	textscale .22
	group grpSystembutton
	style WINDOW_STYLE_FILLED
	rect 2 4 145 20
	textalign ITEM_ALIGN_CENTER
	textalignx 72
	textaligny 14
	border 1
	bordercolor .5 .5 .5 .5
	forecolor 1 1 1 1
	backcolor .3 0.5 0.2 .5
 	visible 1
	action { play "sound/misc/kcaction.wav" ;
	hide grpSystem ; hide grpapplysystem ; hide rend2page ; hide rend2apply ; show graphics ; show graphicsapply ;
	setitemcolor ctr_graphics backcolor .3 0.5 0.2 .5 ; setitemcolor ctr_rend2 backcolor .1 .1 .1 .3 ; setitemcolor ctr_other backcolor .1 .1 .1 .3 }
	}

