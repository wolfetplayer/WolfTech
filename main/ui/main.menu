S#include "ui/menudef.h"

{
	assetGlobalDef {
		#include "ui/fonts.menu"
		cursor "ui/assets/3_cursor3"			
		gradientBar "ui/assets/gradientbar2.tga"	
		itemFocusSound "sound/misc/menu2.wav"
		fadeClamp 1.0				
		fadeCycle 1				
		fadeAmount 0.1				
		shadowColor 0.1 0.1 0.1 0.25			
		}
		
	menuDef {
	name		"backgroundmusic"
	fullScreen	1
	visible		1
	onOpen 
	{
		playlooped "sound/music/l_theme.wav"
	}
    }
		
	menuDef {
	name "main"
	fullScreen MENU_TRUE				
	rect -120 0 900 480			    // Size and position of the menu
	visible MENU_TRUE				// Visible on open
	focusColor 0 0 0 1			// Menu focus color for text and items - black, so hovered button text reads over the white skewed highlight
	
	onOpen { 
		setitemcolor fadebox backcolor 0 0 0 1 ;   
		uiScript stopRefresh ;
		
		hide realrtcw_main_create;
		hide realrtcw_main_join;
		hide realrtcw_main_options;
		hide realrtcw_main_credits;
		hide realrtcw_main_quit;
		
		show realrtcw_main
	}

itemDef
	{
		name realrtcw_background
		style WINDOW_STYLE_SHADER
		rect -120 -9.25 917 500
		background "realrtcw_background"
		visible 1
		decoration
	}
	
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////               IMAGES            //////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

itemDef
	{
		name realrtcw_logo
		style WINDOW_STYLE_SHADER
		rect -107 0 480 480
		background "ui/assets/realrtcw_logo.tga"
		visible 1
		decoration
	}

	
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////                        MAIN MENU BUTTONS    //////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
		
	// CREATE SERVER BUTTON
	itemDef { 
	    name createmenu
	    group mainmenus
	    text "@MAIN_LOBBY_CREATE"
	    type 1
	    rect 10 196 188 34
	    visible 1
	textalign 0
	textalignx 10
	textaligny 24
	textscale .60
		textfont UI_FONT_BIG
		style WINDOW_STYLE_SKEWED
		forecolor 1 1 1 1
		backcolor 1 1 1 0

    	action {
			play "sound/misc/zap.wav" ;
			close main ;
 			open create_menu;
			uiScript loadArenas }

	    mouseEnter { setitemskew createmenu 0 18 ; setitemcolor createmenu backcolor 1 1 1 .92 }
	    mouseExit { setitemskew createmenu 0 0 ; setitemcolor createmenu backcolor 1 1 1 0 ; clearfocus }
	}
	
	// JOIN GAME BUTTON
	itemDef {
		name joinmenu
		text "@MAIN_LOBBY_JOIN"
		group mainmenus
		type 1
	    rect 10 246 161 34
		visible 1
		textfont UI_FONT_BIG
	textalign 0
	textalignx 10
	textaligny 24
	textscale .60
		style WINDOW_STYLE_SKEWED
		forecolor 1 1 1 1
		backcolor 1 1 1 0

    	action {
			play "sound/misc/zap.wav" ;
			close main ;
 			open multi_menu;
			uiScript RefreshServers ;
			uiScript RefreshFilter }

	    mouseEnter { setitemskew joinmenu 0 18 ; setitemcolor joinmenu backcolor 1 1 1 .92 }
	    mouseExit { setitemskew joinmenu 0 0 ; setitemcolor joinmenu backcolor 1 1 1 0 ; clearfocus }
    }
		
    // OPTIONS BUTTON
	itemDef {
		name optionsmenu
		text "@MAIN_OPTIONS"
		group mainmenus
		type 1
	    rect 10 296 121 34
		visible 1
		textfont UI_FONT_BIG
	textalign 0
	textalignx 10
	textaligny 24
	textscale .60
		style WINDOW_STYLE_SKEWED
		forecolor 1 1 1 1
		backcolor 1 1 1 0

		action {play "sound/misc/zap.wav" ;
		close main ;
		open setup_menu ;
		open control_menu }

	    mouseEnter { setitemskew optionsmenu 0 18 ; setitemcolor optionsmenu backcolor 1 1 1 .92 }
	    mouseExit { setitemskew optionsmenu 0 0 ; setitemcolor optionsmenu backcolor 1 1 1 0 ; clearfocus }
    }
	
    // CREDITS BUTTON	
	itemDef {
        name creditsmenu
        text "@MAIN_CREDITS"
		group mainmenus
 	    type 1
	    rect 10 346 121 34
	textalign 0
	textalignx 10
	textaligny 24
	textscale .60
		textfont UI_FONT_BIG
	    visible 1
		style WINDOW_STYLE_SKEWED
		forecolor 1 1 1 1
		backcolor 1 1 1 0

		action {close main;
		open credit }

	    mouseEnter { setitemskew creditsmenu 0 18 ; setitemcolor creditsmenu backcolor 1 1 1 .92 }
	    mouseExit { setitemskew creditsmenu 0 0 ; setitemcolor creditsmenu backcolor 1 1 1 0 ; clearfocus }
	}
	
	// QUIT BUTTON
	itemDef {
        name quit
        text "@MAIN_QUIT"
		group mainmenus
 	    type 1
	    rect 10 396 80 34
		textfont UI_FONT_BIG
	textalign 0
	textalignx 10
	textaligny 24
	textscale .60
	    visible 1
		style WINDOW_STYLE_SKEWED
		forecolor 1 1 1 1
		backcolor 1 1 1 0

		action
		{
		uiScript "quit"
		}

	    mouseEnter { setitemskew quit 0 18 ; setitemcolor quit backcolor 1 1 1 .92 }
	    mouseExit { setitemskew quit 0 0 ; setitemcolor quit backcolor 1 1 1 0 ; clearfocus }
	}
	
}
	
}

		
		
		