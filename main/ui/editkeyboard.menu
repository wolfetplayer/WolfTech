////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////                        STATUS STRIP                     //////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	itemDef {
		name keyBindStatus
		rect 20 441 600 16
		ownerdraw UI_KEYBINDSTATUS
		text " "
		textfont UI_FONT_BIG	// RealRTCWCoop
		forecolor 1 .75 0 1
		textscale .2
		textalignx 300
		textalign 1
		textaligny 12
		visible 0
		decoration
	}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////                        BACK                             //////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	itemDef {
		name backmenu
		text "@MAIN_BACK"
		type 1
		rect 20 458 150 20
		textfont UI_FONT_BIG
		textalign 0
		textalignx 10
		textaligny 15
		textscale .35
		style WINDOW_STYLE_SKEWED
		forecolor 1 1 1 1
		backcolor 1 1 1 0
		visible 1
		action { close editkeyboard_menu ; open control_menu }
		mouseEnter { setitemskew backmenu 0 12 ; setitemcolor backmenu backcolor 1 1 1 .92 }
		mouseExit { setitemskew backmenu 0 0 ; setitemcolor backmenu backcolor 1 1 1 0 ; clearfocus }
	}

}

}
