	itemDef {
		name header_shooting
		group grpKeybinds
		type ITEM_TYPE_TEXT
		text "@CONTROLS_CAT_SHOOTING"
		textfont UI_FONT_BIG
		textalign ITEM_ALIGN_CENTER
		textalignx 140
		textaligny 8
		textscale .2
		rect 30 98 280 10
		style WINDOW_STYLE_FILLED
		backcolor .3 0.5 0.2 .25
		forecolor 1 1 1 1
		visible 1
		decoration
	}

