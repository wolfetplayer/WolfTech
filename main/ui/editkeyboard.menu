#include "ui/menudef.h"

{
\\ EDIT KEYBOARD (full bind list, 2 columns, category dividers) \\

menuDef {
	name "editkeyboard_menu"
	visible 0
	fullscreen 1
	rect 0 0 640 480
	focusColor 1 .75 0 1
	style 1
	border 1
	onClose { uiScript saveControls }
	onOpen {
		setitemcolor fadebox backcolor 0 0 0 1;
		fadeout fadebox;
		show grpKeybinds
		}
	onEsc {
		close editkeyboard_menu;
		open control_menu
		}

// Start of Menu Background

itemDef
	{
		name realrtcw_background
		style WINDOW_STYLE_SHADER
		rect -120 -9.25 917 500
		background "realrtcw_background"
		visible 1
		decoration
	}

itemDef
	{
		name realrtcw_logo
		style WINDOW_STYLE_SHADER
		rect -107 0 480 480
		background "ui/assets/realrtcw_logo.tga"
		visible 1
		decoration
	}

// End of Menu Background

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////                        PANEL                            //////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	itemDef
	{
		name panelframe
		rect 20 90 600 350
		style WINDOW_STYLE_ROUNDED
		cornerradius 10
		forecolor 1 1 1 1
		backcolor 0 0 0 .5
		visible 1
		decoration
	}

