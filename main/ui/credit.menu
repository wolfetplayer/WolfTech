// BACK BAR	//




itemDef {
      	name gotobar
      	style 2
      	rect 0 445 640 20 
      	textscale 0.4
      	textalign 0		// center
      	textalignx 60        	// x alignment point for text
      				     // use it to offset left/right text from the edge 
    					     // or to center the text on a different point
      	textaligny 21        
      	style 2
      	border 4
      	bordercolor 0.5 0.5 0.5 0.0
      	bordersize 2
      	backcolor 0.5 0.5 .5 0.0
      	visible 1 
      	mouseEnter { setcolor backcolor .5 0.5 0.5 .5 }
      	mouseExit { setcolor backcolor .5 .5 .5 .0 }
      	decoration 
    	}









itemDef {
      name back
      text "@GENERAL_BACK"
 	type 1
	textfont UI_FONT_BIG	// RealRTCWCoop  
	style 0	
	textstyle 6
	rect 30 450 40 14 
	textalign 0
	textscale .23		
	textalignx 6
	textaligny 12
	forecolor .9 .9 .9 .9
	visible 1 
     	action { close credit ; open main }
	mouseEnter { hide back ; show back_alt ; show message_back }
    	}

itemDef {
     name back_alt
     text "@GENERAL_BACK"
 	type 1
	textfont UI_FONT_BIG	// RealRTCWCoop  
	style 0	
	textstyle 6
	rect 30 450 40 14 
	textalign 0
	textscale .23		
	textalignx 6
	textaligny 12
	forecolor .6 .6 .6 .6
	visible 1 
	type ITEM_TYPE_BUTTON
     	action { close credit ; open main }	
     mouseExit { hide back_alt ; show back ; hide message_back }	  
    	}





