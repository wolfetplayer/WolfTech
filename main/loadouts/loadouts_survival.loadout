// Every survival player has a class - AICast_ScriptAction_ApplyLoadout looks up
// "<loadout>_<class>" (soldier/medic/engineer/lt), there is no classless loadout.

loadout survival_default_soldier
{
		givescore 500
		giveweapon weapon_knife
		giveweapon weapon_thompson
		setammo weapon_thompson 128
		setclip weapon_thompson full
		selectweapon weapon_thompson

		giveweapon weapon_grenadepineapple
		setammo weapon_grenadepineapple full
}

