// Every survival player has a class - AICast_ScriptAction_ApplyLoadout looks up
// "<loadout>_<class>" (soldier/medic/engineer/lt), there is no classless loadout.

loadout survival_default_soldier
{
		givescore 50

		giveweapon weapon_knife
		giveweapon weapon_thompson
		setammo weapon_thompson full
		setclip weapon_thompson full
		selectweapon weapon_thompson
}

loadout survival_default_medic
{
		givescore 50
		
		giveweapon weapon_knife
		giveweapon weapon_colt
		setammo weapon_colt 64
		setclip weapon_colt full
		selectweapon weapon_colt

		giveweapon weapon_medcrate
		setammo weapon_medcrate full

		setarmor 200
}

loadout survival_default_engineer
{
		givescore 50
		
		giveweapon weapon_knife
		giveweapon weapon_colt
		setammo weapon_colt 64
		setclip weapon_colt full
		selectweapon weapon_colt

		giveweapon weapon_grenadelauncher
		setammo weapon_grenadelauncher full

		giveweapon weapon_dynamite
		setammo weapon_dynamite full

		giveweapon weapon_landmine
		setammo weapon_landmine full
}

loadout survival_default_lt
{
		givescore 150
		
		giveweapon weapon_knife
		giveweapon weapon_colt
		setammo weapon_colt 64
		setclip weapon_colt full
		selectweapon weapon_colt

		giveweapon weapon_airstrike
		giveweapon weapon_arty
		setclip weapon_arty 1
		giveinventory key_binocs
}

