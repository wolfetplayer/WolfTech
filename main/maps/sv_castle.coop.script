game_manager
{
	spawn
	{
		introtitle line "March 1943" line "Castle Wolfenstein, Germany" mission "Escape!" fadein 500 hold 4000 fadeout 1200 stagger 1400
		trigger player map_start	//Prevents late players affecting the game
	}
	

	wave_start
	{
	   mu_play sound/music/survival_wave_start
	   wait 11000
	}

	first_wave_start
	{

	}

	wave_end
	{
	  mu_stop 500
	  mu_play sound/music/survival_wave_end
	}
	
	specialwave_start
	{
	   mu_play sound/music/survival_wave_start
	   wait 11000
	   mu_queue sound/music/x_action
	}

	specialwave_end
	{
	  mu_stop 500
	  mu_play sound/music/survival_wave_end
	}

	// Boss fight (1x protosoldier wave 10, 2x wave 16, then the post-16 random roll).
	boss_start
	{
	   mu_play sound/music/survival_wave_start
	   wait 11000
	   mu_queue sound/music/x_action
	}

	boss_end
	{
	  mu_stop 500
	  mu_play sound/music/survival_wave_end
	}

	start_survival
	{
		// nazi/eg/bg/v/proto/loper pool bootstrap now happens in code (see sv_castle.surv)
	    alertentity friendly1
	    alertentity friendly2
	}
	
}