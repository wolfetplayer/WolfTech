weaponDef
{
	client {
		pickupModel		    "models/weapons/explosives/grenade/grenade_3rd.md3"

		weaponConfig		"models/weapons/explosives/grenade/weapon.cfg"
		handsModel			"models/weapons/explosives/grenade/v_grenade_hand.md3"

		flashDlightColor	1 0.7 0.5
		flashSound			"sound/weapons/grenade/grenlf1a.wav"
		//lastShotSound		""
		reloadSound			"sound/weapons/grenade/grenlf_reload.wav"
		//switchSound		""

		weaponIcon			"icons/iconw_grenade_1"
		weaponSelectedIcon	"icons/iconw_grenade_1_select"

		missileModel		"models/ammo/grenade1.md3"
		missileTrailFunc	"GrenadeTrail"		// GrenadeTrail | RocketTrail | PyroSmokeTrail
		missileTrailTime	1000
		missileTrailRadius	32

		//ejectBrassFunc	""		// PistolEjectBrass | RifleEjectBrass | PanzerFaustEjectBrass

		firstPerson {
			model			"models/weapons/explosives/grenade/v_grenade.md3"

			weaponLink
			{
				part 0
				{
					tag		"tag_barrel"
					model	"models/weapons/explosives/grenade/v_grenade_barrel.md3"
				}
				part 1
				{
					tag		"tag_barrel2"
					model	"models/weapons/explosives/grenade/v_grenade_barrel2.md3"
				}
			}
		}

		thirdPerson {
			model			"models/weapons/explosives/grenade/grenade_3rd.md3"
		}
	}
}
