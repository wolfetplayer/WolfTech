weaponDef
{
	client {
		pickupModel			"models/weapons/smgs/mp34/mp34_3rd.md3"

		weaponConfig		"models/weapons/smgs/mp34/weapon.cfg"
		handsModel			"models/weapons/smgs/mp34/v_mp34_hand.md3"

		flashDlightColor	1.0 0.6 0.23
		flashSound			"sound/weapons/mp34/mp34_fire.wav"
		flashEchoSound		"sound/weapons/mp34/mp34_far.wav"
		//lastShotSound		""

		reloadSound			"sound/weapons/mp34/mp34_reload.wav"
		reloadSoundFast		"sound/weapons/mp34/mp34_reload_fast.wav"
		reloadSoundAi	    "sound/weapons/ai/smg_reload.wav"
		//switchSound		""
		bounceSound         "sound/misc/weapon_bounce.wav"

		weaponIcon			"icons/iconw_mp34"
		weaponSelectedIcon	"icons/iconw_mp34_select"

		ejectBrassFunc		"PistolEjectBrass"		// PistolEjectBrass | RifleEjectBrass | PanzerFaustEjectBrass

		firstPerson {
			model			"models/weapons/smgs/mp34/v_mp34.md3"
			flashModel		"models/weapons/smgs/mp34/v_mp34_flash.md3"

			weaponLink
			{
				part 0
				{
					tag		"tag_barrel"
					model	"models/weapons/smgs/mp34/v_mp34_barrel.md3"
				}
				part 1
				{
					tag		"tag_barrel2"
					model	"models/weapons/smgs/mp34/v_mp34_barrel2.md3"
				}
				part 2
				{
					tag		"tag_barrel3"
					model	"models/weapons/smgs/mp34/v_mp34_barrel3.md3"
				}
			}
		}

		thirdPerson {
			model			"models/weapons/smgs/mp34/mp34_3rd.md3"
			flashModel		"models/weapons/smgs/mp34/mp34_3rd_flash.md3"
		}
	}
}
