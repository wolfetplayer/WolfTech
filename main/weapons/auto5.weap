weaponDef
{
	client {
		pickupModel			"models/weapons/shotguns/auto5/auto5_3rd.md3"

		weaponConfig		"models/weapons/shotguns/auto5/weapon.cfg"
		handsModel			"models/weapons/shotguns/auto5/v_auto5_hand.md3"

		flashDlightColor	1.0 0.6 0.23
		flashSound			"sound/weapons/auto5/auto5_fire.wav"
		flashEchoSound		"sound/weapons/auto5/auto5_far.wav"
		//lastShotSound		""

		reloadSound			"sound/weapons/auto5/auto5_reload.wav"
		reloadSoundFast		"sound/weapons/auto5/auto5_reload_fast.wav"
		pumpSound			"sound/weapons/auto5/auto5_pump_reload.wav"
		bounceSound         "sound/misc/weapon_bounce.wav"

		weaponIcon			"icons/iconw_auto5"
		weaponSelectedIcon	"icons/iconw_auto5_select"

		ejectBrassFunc		"ShotgunEjectBrass"		// PistolEjectBrass | RifleEjectBrass | PanzerFaustEjectBrass | ShotgunEjectBrass

		firstPerson {
			model			"models/weapons/shotguns/auto5/v_auto5.md3"
			flashModel		"models/weapons/shotguns/auto5/v_auto5_flash.md3"

			weaponLink
			{
				part 4
				{
					tag		"tag_barrel5"
					model	"models/weapons/shotguns/auto5/v_auto5_barrel5.md3"
				}
				part 5
				{
					tag		"tag_barrel6"
					model	"models/weapons/shotguns/auto5/v_auto5_barrel6.md3"
				}
				part 8
				{
					tag		"tag_barrel9"
					model	"models/weapons/shotguns/auto5/v_auto5_barrel9.md3"
				}
				part 9
				{
					tag		"tag_barrel10"
					model	"models/weapons/shotguns/auto5/v_auto5_barrel10.md3"
				}
			}
		}

		thirdPerson {
			model			"models/weapons/shotguns/auto5/auto5_3rd.md3"
			flashModel		"models/weapons/shotguns/auto5/auto5_3rd_flash.md3"
		}
	}
}
