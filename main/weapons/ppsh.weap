weaponDef
{
	client {
		pickupModel	        "models/weapons/smgs/ppsh/ppsh_3rd.md3"

		weaponConfig		"models/weapons/smgs/ppsh/weapon.cfg"
		handsModel			"models/weapons/smgs/ppsh/v_ppsh_hand.mdc"

		flashDlightColor	1.0 0.6 0.23
		flashSound			"sound/weapons/ppsh/ppsh_fire.wav"
		flashEchoSound		"sound/weapons/ppsh/ppsh_far.wav"
		//lastShotSound		""

		reloadSound			"sound/weapons/ppsh/ppsh_reload.wav"
		reloadSoundFast		"sound/weapons/ppsh/ppsh_reload_fast.wav"
		reloadSoundAi	    "sound/weapons/ai/smg_reload.wav"
		//switchSound		""
        bounceSound         "sound/misc/weapon_bounce.wav"

		weaponIcon			"icons/iconw_ppsh_1"
		weaponSelectedIcon	"icons/iconw_ppsh_1_select"

		ejectBrassFunc		"PistolEjectBrass"		// PistolEjectBrass | RifleEjectBrass | PanzerFaustEjectBrass

		firstPerson {
			model			"models/weapons/smgs/ppsh/v_ppsh.md3"
			flashModel		"models/weapons/smgs/ppsh/v_ppsh_flash.md3"

			weaponLink
			{
				part 0
				{
					tag		"tag_barrel"
					model	"models/weapons/smgs/ppsh/v_ppsh_barrel.md3"
				}
				part 1
				{
					tag		"tag_barrel2"
					model	"models/weapons/smgs/ppsh/v_ppsh_barrel2.md3"
				}
				part 2
				{
					tag		"tag_barrel3"
					model	"models/weapons/smgs/ppsh/v_ppsh_barrel3.md3"
				}
			}
		}

		thirdPerson {
			model			"models/weapons/smgs/ppsh/ppsh_3rd.md3"
			flashModel		"models/weapons/smgs/ppsh/ppsh_3rd_flash.md3"
		}
	}
}
