weaponDef
{
	client {
		pickupModel			"models/weapons/shotguns/ithaca/ithaca_3rd.md3"

		weaponConfig		"models/weapons/shotguns/ithaca/weapon.cfg"
		handsModel			"models/weapons/shotguns/ithaca/v_ithaca_hand.md3"

		flashDlightColor	1.0 0.6 0.23
		flashSound			"sound/weapons/ithaca/ithaca_fire.wav"
		flashEchoSound		"sound/weapons/ithaca/ithaca_far.wav"
		lastShotSound		"sound/weapons/ithaca/ithaca_fire_last.wav"

		reloadSound			"sound/weapons/ithaca/ithaca_reload.wav"
		reloadSoundFast		"sound/weapons/ithaca/ithaca_reload_fast.wav"
		pumpSound			"sound/weapons/ithaca/ithaca_pump_reload.wav"
		bounceSound         "sound/misc/weapon_bounce.wav"

		weaponIcon			"icons/iconw_ithaca"
		weaponSelectedIcon	"icons/iconw_ithaca_select"

		ejectBrassFunc		"ShotgunEjectBrass"		// PistolEjectBrass | RifleEjectBrass | PanzerFaustEjectBrass | ShotgunEjectBrass

		firstPerson {
			model			"models/weapons/shotguns/ithaca/v_ithaca.md3"
			flashModel		"models/weapons/shotguns/ithaca/v_ithaca_flash.md3"

			weaponLink
			{
				part 4
				{
					tag		"tag_barrel5"
					model	"models/weapons/shotguns/ithaca/v_ithaca_barrel5.md3"
				}
				part 8
				{
					tag		"tag_barrel9"
					model	"models/weapons/shotguns/ithaca/v_ithaca_barrel9.md3"
				}
				part 9
				{
					tag		"tag_barrel10"
					model	"models/weapons/shotguns/ithaca/v_ithaca_barrel10.md3"
				}
			}
		}

		thirdPerson {
			model			"models/weapons/shotguns/ithaca/ithaca_3rd.md3"
			flashModel		"models/weapons/shotguns/ithaca/ithaca_3rd_flash.md3"
		}
	}
}
