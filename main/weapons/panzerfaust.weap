weaponDef
{
	client {
		pickupModel			"models/weapons/heavy/pf/pf_3rd.md3"

		weaponConfig		"models/weapons/heavy/pf/weapon.cfg"
		handsModel			"models/weapons/heavy/pf/v_pf_hand.mdc"

		flashDlightColor	0.75 0.3 0.0
		flashSound			"sound/weapons/rocket/rocklf1a.wav"
		//flashEchoSound	""
		//lastShotSound		""
		//switchSound		""
		bounceSound         "sound/misc/weapon_bounce.wav"

		reloadSound			"sound/weapons/rocket/rocklf_reload.wav"

		weaponIcon			"icons/iconw_panzerfaust_1"
		weaponSelectedIcon	"icons/iconw_panzerfaust_1_select"

		missileModel		"models/ammo/rocket/rocket.md3"
		missileSound		"sound/weapons/rocket/rockfly.wav"
		missileTrailFunc	"RocketTrail"		// GrenadeTrail | RocketTrail | PyroSmokeTrail
		missileDlight		200
		missileDlightColor	0.75 0.3 0.0

		ejectBrassFunc		"PanzerFaustEjectBrass"		// PistolEjectBrass | RifleEjectBrass | PanzerFaustEjectBrass

		firstPerson {
			model			"models/weapons/heavy/pf/v_pf.md3"
			flashModel		"models/weapons/heavy/pf/v_pf_flash.md3"

			weaponLink
			{
				part 0
				{
					tag		"tag_barrel"
					model	"models/weapons/heavy/pf/v_pf_barrel.md3"
				}
				part 1
				{
					tag		"tag_barrel2"
					model	"models/weapons/heavy/pf/v_pf_barrel2.md3"
				}
				part 2
				{
					tag		"tag_barrel3"
					model	"models/weapons/heavy/pf/v_pf_barrel3.md3"
				}
				part 3
				{
					tag		"tag_barrel4"
					model	"models/weapons/heavy/pf/v_pf_barrel4.md3"
				}
				part 4
				{
					tag		"tag_barrel5"
					model	"models/weapons/heavy/pf/v_pf_barrel5.md3"
				}
			}
		}

		thirdPerson {
			model			"models/weapons/heavy/pf/pf_3rd.md3"
			flashModel		"models/weapons/heavy/pf/pf_3rd_flash.mdc"
		}
	}
}
