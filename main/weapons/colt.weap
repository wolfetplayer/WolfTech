weaponDef
{
	client {
		pickupModel		        "models/weapons/pistols/colt/colt_3rd.md3"

		weaponConfig		"models/weapons/pistols/colt/weapon.cfg"
		handsModel			"models/weapons/pistols/colt/v_colt_hand.mdc"

		flashDlightColor	1.0 0.6 0.23
		flashSound			"sound/weapons/colt/colt_fire.wav"
		flashEchoSound		"sound/weapons/colt/colt_far.wav"
		//lastShotSound		""

		reloadSound			"sound/weapons/colt/colt_reload.wav"
		reloadSoundFast		"sound/weapons/colt/colt_reload_fast.wav"
		reloadSoundAi	    "sound/weapons/ai/pistol_reload.wav"
		//switchSound		""
		bounceSound         "sound/misc/weapon_bounce.wav"

		weaponIcon			"icons/iconw_colt_1"
		weaponSelectedIcon	"icons/iconw_colt_1_select"

		ejectBrassFunc		"PistolEjectBrass"		// PistolEjectBrass | RifleEjectBrass | PanzerFaustEjectBrass

		firstPerson {
			model			"models/weapons/pistols/colt/v_colt.md3"
			flashModel		"models/weapons/pistols/colt/v_colt_flash.md3"

			weaponLink
			{
				part 0
				{
					tag		"tag_barrel"
					model	"models/weapons/pistols/colt/v_colt_barrel.md3"
				}
				part 1
				{
					tag		"tag_barrel2"
					model	"models/weapons/pistols/colt/v_colt_barrel2.md3"
				}
				part 2
				{
					tag		"tag_barrel3"
					model	"models/weapons/pistols/colt/v_colt_barrel3.md3"
				}
				part 3
				{
					tag		"tag_barrel4"
					model	"models/weapons/pistols/colt/v_colt_barrel4.md3"
				}
			}
		}

		thirdPerson {
			model			"models/weapons/pistols/colt/colt_3rd.md3"
			flashModel		"models/weapons/pistols/colt/colt_3rd_flash.md3"
		}
	}
}
