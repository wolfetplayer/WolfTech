		reloadSoundAi	    "sound/weapons/ai/ar_reload.wav"
		//switchSound		""
		bounceSound         "sound/misc/weapon_bounce.wav"
		fireModeSwitchSound	"sound/weapons/misc/firemode_switch.wav"

		weaponIcon			"icons/iconw_mp44"
		weaponSelectedIcon	"icons/iconw_mp44_select"

		ejectBrassFunc		"RifleEjectBrass"		// PistolEjectBrass | RifleEjectBrass | PanzerFaustEjectBrass

		firstPerson {
			model			"models/weapons/assault_rifles/mp44/v_mp44.md3"
