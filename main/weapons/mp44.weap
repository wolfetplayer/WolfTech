				}
				part 2
				{
					tag		"tag_barrel3"
					model	"models/weapons/assault_rifles/mp44/v_mp44_barrel3.md3"
				}
			}
		}

		thirdPerson {
			model			"models/weapons/assault_rifles/mp44/mp44_3rd.md3"
			flashModel		"models/weapons/assault_rifles/mp44/mp44_3rd_flash.md3"
