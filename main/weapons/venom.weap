weaponDef
{
	client {
		pickupModel			"models/weapons/secret/venom/venom_pickup.md3"

		weaponConfig		"models/weapons/secret/venom/weapon.cfg"
		handsModel			"models/weapons/secret/venom/v_venom_hand.mdc"

		flashDlightColor	1.0 0.6 0.23
		flashSound			"sound/weapons/venom/venom_fire.wav"
		flashEchoSound		"sound/weapons/venom/venom_far.wav"
		//lastShotSound		""

		reloadSound			"sound/weapons/venom/venom_reload.wav"
		reloadSoundFast		"sound/weapons/venom/venom_reload_fast.wav"
		overheatSound		"sound/weapons/venom/venom_overheat.wav"
		spinupSound		    "sound/weapons/venom/venomsu1.wav"
		spindownSound		"sound/weapons/venom/venomsd1.wav"
		//switchSound		""
		bounceSound         "sound/misc/weapon_bounce.wav"

		weaponIcon			"icons/iconw_venom_1"
		weaponSelectedIcon	"icons/iconw_venom_1_select"

		ejectBrassFunc		"RifleEjectBrass"		// PistolEjectBrass | RifleEjectBrass | PanzerFaustEjectBrass

		firstPerson {
			model			"models/weapons/secret/venom/v_venom.md3"
			flashModel		"models/weapons/secret/venom/v_venom_flash.md3"

			weaponLink
			{
				part 0
				{
					tag		"tag_barrel"
					model	"models/weapons/secret/venom/v_venom_barrel.md3"
				}
				part 3
				{
					tag		"tag_barrel4"
					model	"models/weapons/secret/venom/v_venom_barrel4.md3"
				}
				part 4
				{
					tag		"tag_barrel5"
					model	"models/weapons/secret/venom/v_venom_barrel5.md3"
				}
			}
		}

		thirdPerson {
			model			"models/weapons/secret/venom/venom_3rd.md3"
			flashModel		"models/weapons/secret/venom/venom_3rd_flash.md3"
		}
	}
}
