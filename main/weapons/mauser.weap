			weaponLink
			{
				part 0
				{
					tag		"tag_barrel"
					model	"models/weapons/rifles/mauser/v_mauser_barrel.md3"
				}
				part 2
				{
					tag		"tag_barrel3"
					model	"models/weapons/rifles/mauser/v_mauser_barrel3.md3"
				}
				part 3
				{
					tag		"tag_barrel4"
					model	"models/weapons/rifles/mauser/v_mauser_barrel4.md3"
				}
			}
		}

		thirdPerson {
			model			"models/weapons/rifles/mauser/mauser_3rd.md3"
