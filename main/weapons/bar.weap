weaponDef
{
	client {
		pickupModel		    "models/weapons/assault_rifles/bar/bar_3rd.md3"

		weaponConfig		"models/weapons/assault_rifles/bar/weapon.cfg"
		handsModel			"models/weapons/assault_rifles/bar/v_bar_hand.md3"

		flashDlightColor	1.0 0.6 0.23
		flashSound			"sound/weapons/bar/bar_fire.wav"
		flashEchoSound		"sound/weapons/bar/bar_far.wav"
		//lastShotSound		""

		reloadSound			"sound/weapons/bar/bar_reload.wav"
		reloadSoundFast		"sound/weapons/bar/bar_reload_fast.wav"
		reloadSoundAi	    "sound/weapons/ai/ar_reload.wav"
		//switchSound		""
		bounceSound         "sound/misc/weapon_bounce.wav"
		fireModeSwitchSound	"sound/weapons/misc/firemode_switch.wav"

		weaponIcon			"icons/iconw_bar"
		weaponSelectedIcon	"icons/iconw_bar_select"

		ejectBrassFunc		"RifleEjectBrass"		// PistolEjectBrass | RifleEjectBrass | PanzerFaustEjectBrass

		firstPerson {
			model			"models/weapons/assault_rifles/bar/v_bar.md3"
			flashModel		"models/weapons/assault_rifles/bar/v_bar_flash.md3"

			weaponLink
			{
				part 0
				{
					tag		"tag_barrel"
					model	"models/weapons/assault_rifles/bar/v_bar_barrel.md3"
				}
				part 1
				{
					tag		"tag_barrel2"
					model	"models/weapons/assault_rifles/bar/v_bar_barrel2.md3"
				}
				part 2
				{
					tag		"tag_barrel3"
					model	"models/weapons/assault_rifles/bar/v_bar_barrel3.md3"
				}
				part 3
				{
					tag		"tag_barrel4"
					model	"models/weapons/assault_rifles/bar/v_bar_barrel4.md3"
				}
			}
		}

		thirdPerson {
			model			"models/weapons/assault_rifles/bar/bar_3rd.md3"
			flashModel		"models/weapons/assault_rifles/bar/bar_3rd_flash.md3"
		}
	}
}
