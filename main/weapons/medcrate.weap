weaponDef
{
	client {
		weaponConfig		"models/weapons/misc/medcrate/weapon.cfg"
		handsModel			"models/weapons/misc/medcrate/v_medcrate_hand.md3"

		missileModel		"models/weapons/misc/medcrate/medcrate_throw.md3"
		droppedModel		"models/weapons/misc/medcrate/medcrate_dropped.md3"

		flashSound			"sound/weapons/medcrate/throw.wav"
		landSound			"sound/weapons/medcrate/land.wav"
		healSound			"sound/weapons/medcrate/heal.wav"

		weaponIcon			"icons/iconw_medcrate_1"
//		weaponSelectedIcon	"icons/iconh_large"	// unused - HUD uses a gold tint instead
		ammoIcon			"icons/iconh_large"

		// NOTE: bounceSound doesn't apply to thrown missiles (dropped items only); landing thud uses landSound above via EV_GRENADE_BOUNCE.

		firstPerson {
			model		"models/weapons/misc/medcrate/v_medcrate.md3"
		}

		thirdPerson {
			model		"models/weapons/misc/medcrate/medcrate_3rd.md3"
		}
	}
}
