textures/wt_vista/tree_birch01
{
	qer_editorimage textures/wt_vista/tree_birch01.tga
	qer_alphafunc greater 0.5
	surfaceparm trans
	surfaceparm alphashadow
	surfaceparm nomarks
	nopicmip
	cull disable
	{
		map textures/wt_vista/tree_birch01.tga
		alphaFunc GE128
		depthWrite
		rgbGen vertex
	}
}

