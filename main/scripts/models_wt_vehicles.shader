models/mapobjects/wt_vehicles/blitz
{
	    qer_editorimage models/mapobjects/wt_vehicles/blitz.jpg
		{
		map models/mapobjects/wt_vehicles/blitz.jpg
		rgbGen vertex
		}
		{
			map $lightmap
			blendFunc filter
			rgbGen identity
		}
}

models/mapobjects/wt_vehicles/blitz_wheels
{
	    qer_editorimage models/mapobjects/wt_vehicles/blitz_wheels.jpg
		{
		map models/mapobjects/wt_vehicles/blitz_wheels.jpg
		rgbGen vertex
		}
		{
			map $lightmap
			blendFunc filter
			rgbGen identity
		}
}

models/mapobjects/wt_vehicles/blitz_glass
{
	    qer_editorimage models/mapobjects/wt_vehicles/blitz_glass.png
		cull twosided
		{
		map models/mapobjects/wt_vehicles/blitz_glass.png
		blendFunc blend
		rgbGen vertex
		}
}
