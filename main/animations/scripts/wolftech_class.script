//==========================================================================
//
// WolfTech class character animation script
//
// Shared by all characters/*.char class models (they all bind to the same
// animations/human_base.anim skeleton). Conditions the locomotion pose on
// WEAPONS (ANIM_COND_WEAPON), matching real pickup_name strings from
// bg_itemlist[] in bg_misc.c - grouped by how the weapon is actually held,
// cross-checked against each WP_'s weaponClass in bg_misc.c's ammoTable so
// every weapon lands in the right bucket:
//
//   two_handed    - bolt-action rifles/shotguns/flamer-type weapons with no
//                   better dedicated clip family available (falls back to
//                   the plain rifle pose)
//   self_loading  - unscoped semi/select-fire rifles (WEAPON_CLASS_RIFLE_AUTO
//                   / WEAPON_CLASS_ASSAULT_RIFLE); reuses the same _srifle
//                   clips as the sniper bucket below, matching stock ET's
//                   own human_base.script (Garand/FG42/K43 use stand_srifle
//                   even unscoped there)
//   sniper        - WEAPON_CLASS_SCOPED
//   smg           - WEAPON_CLASS_SMG; body.aninc's "machinegun" clip family
//                   is the SMG carry/fire pose in ET's naming, not a heavy MG
//   akimbo        - WEAPON_CLASS_AKIMBO; only overrides FIREWEAPON below -
//                   akimbo.mdx has no locomotion clips of its own, so these
//                   stay in one_handed for movement (see human_base.anim,
//                   which now registers akimbo.mdx alongside body.mdx)
//   panzerfaust   - WEAPON_CLASS_LAUNCHER
//   mg            - WEAPON_CLASS_MG; carried/fired like a heavy SMG, not a
//                   mounted emplacement, so it uses the "mobilemg42" clips
//   grenlauncher  - WEAPON_CLASS_RIFLENADE (M7), directly analogous to ET's
//                   own gpg40/gpg40a rifle-grenade-launcher attachment
//   one_handed    - WEAPON_CLASS_PISTOL (incl. akimbo pistols, for movement)
//   no_weapon     - melee/throwables/utility items with no better clip
//
// PAIN/DEATH stay fully generic.
//
//==========================================================================

DEFINES

set weapons two_handed = Mauser Rifle AND Ithaca 37 AND Auto-5 AND De Lisle Carbine AND Mosin-Nagant AND Venom AND Flamethrower AND Tesla Gun
set weapons self_loading = M1 Garand AND FG42 Paratroop Rifle AND Browning Automatic Rifle AND MP44 Sturmgewehr AND G43 rifle AND M1941
set weapons sniper = Sniper Scope AND Snooper Rifle AND M1941 Scope AND De Lisle Scope AND FG42 Scope
set weapons smg = Thompson AND Sten AND MP40 AND MP34 AND PPSh-41
set weapons akimbo = Dual Colts AND Dual TT-33s
set weapons panzerfaust = Panzerfaust
set weapons mg = MG42 AND Browning M1919
set weapons grenlauncher = M7 Grenade Launcher
set weapons one_handed = Luger AND Dual Colts AND Colt AND TT-33 AND Dual TT-33s AND Revolver AND HDM AND sp5 pistol
set weapons no_weapon = Knife AND Grenade AND Pineapple AND Dynamite Weapon AND Landmine AND Medical Crate AND Airstrike Signal AND Artillery

ANIMATIONS

state RELAXED
{
	IDLE
	{
		WEAPONS no_weapon
		{
			both relaxed_idle_no
		}
		WEAPONS one_handed
		{
			both alert_idle_1h
		}
		default
		{
			both relaxed_idle_2h_1
		}
	}

	IDLECR
	{
		WEAPONS sniper
		{
			both alert_crchidle_srifle
		}
		WEAPONS self_loading
		{
			both alert_crchidle_srifle
		}
		WEAPONS one_handed
		{
			both alert_crchidle_1h
		}
		default
		{
			both alert_crchidle_2h
		}
	}

	WALK
	{
		WEAPONS no_weapon
		{
			both relaxed_walk_no
		}
		WEAPONS one_handed
		{
			both relaxed_walk_1h_1
		}
		default
		{
			both relaxed_walk_2h_1
		}
	}

	WALKBK
	{
		WEAPONS sniper
		{
			both alert_bk_srifle
		}
		WEAPONS self_loading
		{
			both alert_bk_srifle
		}
		WEAPONS one_handed
		{
			both alert_bk_1h
		}
		default
		{
			both alert_bk_2h
		}
	}

	WALKCR
	{
		WEAPONS sniper
		{
			both alert_crch_srifle
		}
		WEAPONS self_loading
		{
			both alert_crch_srifle
		}
		WEAPONS one_handed
		{
			both alert_crch_1h
		}
		default
		{
			both alert_crch_2h
		}
	}

	WALKCRBK
	{
		WEAPONS sniper
		{
			both alert_crbk_srifle
		}
		WEAPONS self_loading
		{
			both alert_crbk_srifle
		}
		WEAPONS one_handed
		{
			both alert_crbk_1h
		}
		default
		{
			both alert_crbk_2h
		}
	}

	RUN
	{
		WEAPONS sniper
		{
			both alert_run_srifle
		}
		WEAPONS self_loading
		{
			both alert_run_srifle
		}
		WEAPONS no_weapon
		{
			both alert_run_no
		}
		WEAPONS one_handed
		{
			both alert_run_1h
		}
		default
		{
			both alert_run_2h
		}
	}

	RUNBK
	{
		WEAPONS sniper
		{
			both alert_bk_srifle
		}
		WEAPONS self_loading
		{
			both alert_bk_srifle
		}
		WEAPONS one_handed
		{
			both alert_bk_1h
		}
		default
		{
			both alert_bk_2h
		}
	}

	SWIM
	{
		WEAPONS one_handed
		{
			both e_swim_1h
		}
		default
		{
			both e_swim_2h
		}
	}

	SWIMBK
	{
		WEAPONS one_handed
		{
			both e_swim_1h
		}
		default
		{
			both e_swim_2h
		}
	}

	STRAFERIGHT
	{
		default
		{
			both alert_strafe_1h_R
		}
	}

	STRAFELEFT
	{
		default
		{
			both alert_strafe_1h_L
		}
	}

	TURNRIGHT
	{
		default
		{
			both turn_1h_R
		}
	}

	TURNLEFT
	{
		default
		{
			both turn_1h_R
		}
	}

	CLIMBUP
	{
		default
		{
			both climb_up
		}
	}

	CLIMBDOWN
	{
		default
		{
			both climb_down
		}
	}
}

EVENTS

PAIN
{
	default
	{
		both pain_chest
	}
}

DEATH
{
	default
	{
		both death_machinegun_1
	}
}

FIREWEAPON
{
	WEAPONS sniper
	{
		both firing_srifle
	}
	WEAPONS self_loading
	{
		both firing_srifle
	}
	WEAPONS akimbo
	{
		both firing_akimbo
	}
	WEAPONS one_handed
	{
		both firing_pistolA_1
	}
	WEAPONS smg
	{
		both firing_machinegun
	}
	WEAPONS panzerfaust
	{
		both firing_panzer
	}
	WEAPONS mg
	{
		both firing_mobilemg42
	}
	WEAPONS grenlauncher
	{
		both firing_grenlauncher
	}
	WEAPONS no_weapon
	{
		both firing_knifeA
	}
	default
	{
		both firing_rifle
	}
}

JUMP
{
	WEAPONS one_handed
	{
		both jump_1step_1h
	}
	default
	{
		both jump_1step_2h
	}
}
