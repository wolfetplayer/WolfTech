{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-steam-debug",
      "type": "shell",
      "command": "ARCH=x86_64 STEAM=1 mingw32-make debug",
      "group": "build",
      "problemMatcher": ["$gcc"],
      "detail": "Builds the Steam version of RealRTCW with debug configuration.",
      "options": {
        "shell": {
          "executable": "C:/msys64/usr/bin/bash.exe",
          "args": ["-c"]
        }
      }
    },
    {
      "label": "build-nonsteam-debug",
      "type": "shell",
      "command": "ARCH=x86_64 mingw32-make debug",
      "group": "build",
      "problemMatcher": ["$gcc"],
      "detail": "Builds the standalone (non-Steam) version of RealRTCW with debug configuration.",
      "options": {
        "shell": {
          "executable": "C:/msys64/usr/bin/bash.exe",
          "args": ["-c"]
        }
      }
    },
    {
